---
import { NAV_LINKS, SITE } from '../data/site';

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  const base = href.endsWith('/') ? href : href + '/';
  return pathname === base || pathname === href.replace(/\/$/, '') || pathname.startsWith(base);
}
---

<header
  id="wuji-navbar"
  class="fixed top-0 inset-x-0 z-40 wuji-glass border-b border-[var(--border-hairline)]"
>
  <nav
    aria-label="主导航"
    class="max-w-5xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between"
  >
    <!-- Brand: Quiet Songti Name + Single Antique Square Seal -->
    <a
      href="/"
      class="group flex items-center gap-2.5 focus:outline-none"
      aria-label="无极 WuJi 首页"
    >
      <span
        class="text-xl font-bold tracking-[0.18em] text-[var(--text-primary)] font-editorial"
      >
        {SITE.name}
      </span>
      <span class="wuji-seal w-5 h-5 text-[11px] group-hover:rotate-6 transition-transform">
        印
      </span>
      <span class="hidden sm:inline text-[11px] font-mono tracking-[0.22em] text-[var(--text-muted)] pl-1 border-l border-[var(--border-hairline)]">
        {SITE.enName}
      </span>
    </a>

    <!-- Desktop Editorial Text Links -->
    <div class="hidden md:flex items-center gap-7">
      {
        NAV_LINKS.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                'relative py-1 text-[14px] tracking-[0.08em] transition-colors',
                active
                  ? 'text-[var(--text-primary)] font-medium'
                  : 'text-[var(--text-muted)] hover:text-[var(--text-primary)]',
              ]}
            >
              {link.label}
              {active && (
                <span class="absolute left-0 right-0 -bottom-[21px] h-[2px] bg-[var(--accent-seal)]" />
              )}
            </a>
          );
        })
      }
    </div>

    <!-- Quiet Utility Controls -->
    <div class="flex items-center gap-4 text-[13px]">
      <button
        id="open-search-btn"
        type="button"
        class="flex items-center gap-1.5 text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
        aria-label="搜索文章 (⌘K)"
      >
        <span>寻文</span>
        <kbd class="hidden lg:inline text-[10px] font-mono px-1.5 py-0.5 border border-[var(--border-hairline)] rounded-[2px] text-[var(--text-muted)]">
          ⌘K
        </kbd>
      </button>

      <span class="h-3 w-[1px] bg-[var(--border-hairline)]" aria-hidden="true"></span>

      <button
        id="nav-sky-btn"
        type="button"
        class="text-[var(--text-muted)] hover:text-[var(--accent-seal)] transition-colors cursor-pointer"
        aria-label="切换四时天轨景致"
        title="点击切换预览春晨、夏夜、秋暮、冬望与实时天时"
      >
        四时
      </button>

      <button
        id="ink-fx-toggle-btn"
        type="button"
        class="flex items-center gap-1.5 text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors cursor-pointer"
        aria-label="开关水墨互动特效"
        title="开关水墨笔迹与墨晕特效"
      >
        <span id="ink-fx-dot" class="w-1.5 h-1.5 rounded-full bg-[var(--accent-seal)]"></span>
        <span>墨韵</span>
      </button>

      <button
        id="theme-toggle-btn"
        type="button"
        class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
        aria-label="切换宣纸/墨夜主题"
        title="切换宣纸 / 墨夜"
      >
        <span id="theme-label">墨夜</span>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer pl-1"
        aria-label="打开菜单"
        aria-expanded="false"
      >
        <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[var(--border-hairline)] bg-[var(--bg-surface)] px-5 py-4"
  >
    <div class="grid grid-cols-3 gap-2">
      {
        NAV_LINKS.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                'py-2 text-center text-sm border rounded-[2px] transition-colors',
                active
                  ? 'border-[var(--accent-seal)] text-[var(--accent-seal)] bg-[var(--accent-seal-soft)]'
                  : 'border-[var(--border-hairline)] text-[var(--text-secondary)]',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </div>
  </div>
</header>

<script>
  const themeBtn = document.getElementById('theme-toggle-btn');
  const themeLabel = document.getElementById('theme-label');
  const fxBtn = document.getElementById('ink-fx-toggle-btn');
  const fxDot = document.getElementById('ink-fx-dot');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function syncThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    if (themeLabel) themeLabel.textContent = isDark ? '宣纸' : '墨夜';
  }

  function syncInkFxUI() {
    const enabled = localStorage.getItem('wuji-ink-fx') !== 'off';
    if (fxBtn && fxDot) {
      fxBtn.classList.toggle('opacity-45', !enabled);
      fxDot.classList.toggle('opacity-20', !enabled);
    }
  }

  syncThemeUI();
  syncInkFxUI();

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('wuji-ink-theme', isDark ? 'dark' : 'light');
    syncThemeUI();
    window.dispatchEvent(new CustomEvent('wuji-theme-change', { detail: { theme: isDark ? 'dark' : 'light' } }));
    window.dispatchEvent(new CustomEvent('wuji-ink-splash', { detail: { isRed: false, big: true } }));
  }

  themeBtn?.addEventListener('click', toggleTheme);
  window.addEventListener('wuji-request-theme-toggle', toggleTheme);

  document.getElementById('nav-sky-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('wuji-cycle-sky'));
  });

  fxBtn?.addEventListener('click', () => {
    const currentlyEnabled = localStorage.getItem('wuji-ink-fx') !== 'off';
    const next = !currentlyEnabled;
    localStorage.setItem('wuji-ink-fx', next ? 'on' : 'off');
    syncInkFxUI();
    window.dispatchEvent(new CustomEvent('wuji-ink-toggle', { detail: { enabled: next } }));
    if (next) {
      window.dispatchEvent(new CustomEvent('wuji-ink-splash', { detail: { isRed: true, big: false } }));
    }
  });

  mobileBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    mobileBtn.setAttribute('aria-expanded', String(!isHidden));
  });
</script>
