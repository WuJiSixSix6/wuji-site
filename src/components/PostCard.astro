---
import type { BlogPost } from '../utils/blog';
import { computePostMeta, formatDate } from '../utils/blog';

interface Props {
  post: BlogPost;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const { wordCount, readingMinutes } = computePostMeta(post.body);
const dateDots = formatDate(post.data.pubDate).replace(/-/g, '.');
---

<article
  class="wuji-card wuji-card-interactive ink-reveal group flex flex-col justify-between p-6 sm:p-7 h-full"
  data-category={post.data.category}
  data-tags={post.data.tags.join(',')}
  data-title={post.data.title.toLowerCase()}
  data-summary={post.data.summary.toLowerCase()}
  data-date={post.data.pubDate.valueOf()}
  data-reading={readingMinutes}
>
  <div>
    <!-- Top Editorial Metadata Line -->
    <div class="flex items-center justify-between gap-3 text-xs text-[var(--text-muted)] mb-4">
      <div class="flex items-center gap-2">
        <a
          href={`/categories/${encodeURIComponent(post.data.category)}/`}
          class="text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors"
        >
          「{post.data.category}」
        </a>
        {post.data.pinned && (
          <span class="wuji-seal px-1.5 py-0.5 text-[10px]">置顶</span>
        )}
      </div>
      <time class="font-mono text-[11px] tracking-wider">{dateDots}</time>
    </div>

    <!-- Songti Editorial Headline -->
    <h3
      class="text-lg sm:text-[1.22rem] font-bold leading-snug text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] transition-colors line-clamp-2 font-editorial"
    >
      <a href={`/blog/${post.id}/`} class="focus:outline-none">
        {post.data.title}
      </a>
    </h3>

    <!-- Summary -->
    <p
      class:list={[
        'mt-3 text-[14px] text-[var(--text-secondary)] leading-[1.82]',
        compact ? 'line-clamp-2' : 'line-clamp-3',
      ]}
    >
      {post.data.summary}
    </p>
  </div>

  <!-- Quiet Footer Rule -->
  <div class="mt-6 pt-4 border-t border-[var(--border-hairline)] flex items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-2.5 text-[11px] font-mono text-[var(--text-muted)] min-w-0 truncate">
      <span>{readingMinutes} 分钟</span>
      {!compact && (
        <>
          <span>·</span>
          <span>{wordCount.toLocaleString()} 字</span>
        </>
      )}
      {!compact && post.data.tags[0] && (
        <>
          <span class="hidden sm:inline">·</span>
          <a
            href={`/tags/${encodeURIComponent(post.data.tags[0])}/`}
            class="hidden sm:inline hover:text-[var(--accent-seal)] transition-colors truncate"
          >
            #{post.data.tags[0]}
          </a>
        </>
      )}
    </div>

    <a
      href={`/blog/${post.id}/`}
      class="shrink-0 text-xs text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] transition-colors tracking-wider"
    >
      阅读 →
    </a>
  </div>
</article>
