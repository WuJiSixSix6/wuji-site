---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryMeta } from '../../data/site';
import { getPublishedPosts, getCategoriesMap, formatDate } from '../../utils/blog';

const posts = await getPublishedPosts();
const categories = getCategoriesMap(posts);
---

<BaseLayout title="文章分类" description="按专题分类浏览无极 (WuJi) 的全部博客内容。">
  <section class="max-w-5xl mx-auto px-5 sm:px-8 pt-8 pb-20">
    <header class="pb-8 border-b border-[var(--border-strong)] mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] font-editorial tracking-wide">
        卷目分类
      </h1>
      <p class="mt-3 text-sm text-[var(--text-secondary)]">
        共分 <span class="font-mono text-[var(--text-primary)]">{categories.length}</span> 个专题。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        categories.map((cat, idx) => {
          const meta = getCategoryMeta(cat.name);
          const num = String(idx + 1).padStart(2, '0');
          return (
            <div class="wuji-card ink-reveal p-6 sm:p-7 flex flex-col justify-between">
              <div>
                <div class="flex items-baseline justify-between gap-4 pb-3 border-b border-[var(--border-hairline)]">
                  <div class="flex items-baseline gap-3">
                    <span class="font-mono text-xs text-[var(--text-muted)]">{num}</span>
                    <h2 class="text-xl font-bold font-editorial text-[var(--text-primary)]">
                      <a
                        href={`/categories/${encodeURIComponent(cat.name)}/`}
                        class="hover:text-[var(--accent-seal)] transition-colors"
                      >
                        {cat.name}
                      </a>
                    </h2>
                  </div>
                  <span class="text-xs font-mono text-[var(--text-muted)]">{cat.count} 篇</span>
                </div>

                <p class="mt-3.5 text-sm text-[var(--text-secondary)] leading-relaxed">
                  {meta.desc}
                </p>

                <div class="mt-5 space-y-2.5">
                  {cat.posts.slice(0, 3).map((post) => (
                    <a
                      href={`/blog/${post.id}/`}
                      class="group/item flex items-baseline justify-between gap-3 text-sm"
                    >
                      <span class="text-[var(--text-primary)] group-hover/item:text-[var(--accent-seal)] transition-colors line-clamp-1 font-editorial">
                        · {post.data.title}
                      </span>
                      <span class="shrink-0 text-[11px] font-mono text-[var(--text-muted)]">
                        {formatDate(post.data.pubDate).replace(/-/g, '.')}
                      </span>
                    </a>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-[var(--border-hairline)] flex justify-end">
                <a
                  href={`/categories/${encodeURIComponent(cat.name)}/`}
                  class="text-xs text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors"
                >
                  查看本卷全部 →
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
