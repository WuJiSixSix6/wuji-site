  </defs>
  <circle
    cx="32"
    cy="32"
    r="27"
    stroke="url(#wuji-logo-grad)"
    stroke-opacity="0.35"
    stroke-width="1.2"
  />
  <circle
    cx="32"
    cy="32"
    r="22"
    stroke="url(#wuji-logo-grad)"
    stroke-width="1.6"
    stroke-dasharray="98 20"
    stroke-linecap="round"
