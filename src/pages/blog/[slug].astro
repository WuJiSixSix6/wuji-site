---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import PostCard from '../../components/PostCard.astro';
import ArticleSealStamp from '../../components/ArticleSealStamp.astro';
import { SITE } from '../../data/site';
import {
  getChronologicalPosts,
  computePostMeta,
  formatDateCN,
  getRelatedPosts,
} from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getChronologicalPosts();
  return posts.map((post, idx) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: posts[idx + 1] || null,
      nextPost: posts[idx - 1] || null,
      allPosts: posts,
    },
  }));
}

const { post, prevPost, nextPost, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const { wordCount, readingMinutes } = computePostMeta(post.body);
const relatedPosts = getRelatedPosts(post, allPosts, 2);
---

<BaseLayout title={post.data.title} description={post.data.summary} ogType="article">
  <ReadingProgress />

  <article class="max-w-5xl mx-auto px-5 sm:px-8 pt-6 pb-20">
    <!-- Breadcrumb -->
    <nav aria-label="面包屑导航" class="flex flex-wrap items-center gap-2 text-xs text-[var(--text-muted)] mb-8">
      <a href="/" class="hover:text-[var(--text-primary)] transition-colors">首页</a>
      <span>/</span>
      <a href="/blog/" class="hover:text-[var(--text-primary)] transition-colors">文集</a>
      <span>/</span>
      <a
        href={`/categories/${encodeURIComponent(post.data.category)}/`}
        class="text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors"
      >
        「{post.data.category}」
      </a>
    </nav>

    <!-- Editorial Title Plate (书卷扉页，克制留白) -->
    <header class="pb-9 border-b border-[var(--border-strong)]">
      <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--text-muted)] mb-5">
        <a
          href={`/categories/${encodeURIComponent(post.data.category)}/`}
          class="text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors"
        >
          「{post.data.category}」
        </a>
        {post.data.pinned && (
          <span class="wuji-seal px-1.5 py-0.5 text-[10px]">卷首</span>
        )}
        <span>·</span>
        <span class="font-mono">{formatDateCN(post.data.pubDate)}</span>
        {post.data.updatedDate && (
          <>
            <span>·</span>
            <span class="font-mono">修订于 {formatDateCN(post.data.updatedDate)}</span>
          </>
        )}
      </div>

      <h1
        class="text-3xl sm:text-4xl lg:text-[2.65rem] font-bold text-[var(--text-primary)] leading-[1.28] tracking-tight font-editorial max-w-4xl"
      >
        {post.data.title}
      </h1>

      {post.data.subtitle && (
        <p class="mt-4 text-base sm:text-lg text-[var(--text-muted)] leading-relaxed font-editorial max-w-3xl">
          {post.data.subtitle}
        </p>
      )}

      <div class="mt-7 flex flex-wrap items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
        <div class="flex flex-wrap items-center gap-4 font-mono">
          <span class="text-[var(--text-secondary)] font-sans">{SITE.author}</span>
          <span>约 {wordCount.toLocaleString()} 字</span>
          <span>预计 {readingMinutes} 分钟</span>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          {post.data.tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class="font-mono text-[11px] text-[var(--text-muted)] hover:text-[var(--accent-seal)] transition-colors"
            >
              #{tag}
            </a>
          ))}
          <button
            id="copy-article-link-btn"
            type="button"
            class="pl-3 border-l border-[var(--border-hairline)] text-[11px] text-[var(--text-muted)] hover:text-[var(--accent-seal)] transition-colors cursor-pointer"
          >
            复制链接
          </button>
        </div>
      </div>
    </header>

    <!-- Main 2-column reading layout -->
    <div class="mt-10 grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_240px] gap-12 items-start">
      <div class="min-w-0">
        <!-- Mobile / Tablet TOC -->
        <div class="xl:hidden">
          <TableOfContents headings={headings} />
        </div>

        <!-- Executive Summary Box (提要) -->
        <section
          aria-label="文章摘要"
          class="mb-10 pl-5 py-1 border-l-2 border-[var(--accent-seal)]"
        >
          <p class="text-xs font-editorial tracking-[0.2em] text-[var(--accent-seal)] mb-2">
            提要
          </p>
          <p class="text-[15px] text-[var(--text-secondary)] leading-[1.88] font-editorial">
            {post.data.summary}
          </p>
        </section>

        <!-- Rendered Markdown / MDX Prose -->
        <div class="wuji-prose">
          <Content />
        </div>

        <!-- Interactive Vermilion Seal Stamp Colophon -->
        <ArticleSealStamp slug={post.id} />

        <!-- Quiet Author Colophon -->
        <div class="mt-10 py-6 border-t border-b border-[var(--border-hairline)] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <span class="wuji-seal w-9 h-9 text-sm shrink-0">无极</span>
            <div>
              <div class="text-sm font-bold text-[var(--text-primary)] font-editorial">
                {SITE.author}
              </div>
              <p class="text-xs text-[var(--text-muted)] mt-0.5">
                {SITE.tagline} 感谢阅览。
              </p>
            </div>
          </div>
          <div class="flex items-center gap-5 text-xs text-[var(--text-muted)]">
            <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)] transition-colors">
              GitHub ↗
            </a>
            <a href="/rss.xml" class="hover:text-[var(--accent-seal)] transition-colors">
              RSS 订阅
            </a>
          </div>
        </div>

        <!-- Prev / Next Navigation -->
        <nav aria-label="上下篇导航" class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.id}/`}
              class="group block py-3"
            >
              <span class="text-xs text-[var(--text-muted)]">← 上一篇</span>
              <span class="mt-1.5 block text-sm sm:text-base font-bold font-editorial text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] transition-colors line-clamp-2">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div />
          )}

          {nextPost && (
            <a
              href={`/blog/${nextPost.id}/`}
              class="group block py-3 sm:text-right"
            >
              <span class="text-xs text-[var(--text-muted)]">下一篇 →</span>
              <span class="mt-1.5 block text-sm sm:text-base font-bold font-editorial text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] transition-colors line-clamp-2">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </nav>
      </div>

      <!-- Right: Sticky Desktop TOC -->
      <div class="hidden xl:block">
        <TableOfContents headings={headings} />
      </div>
    </div>

    <!-- Related Articles -->
    {
      relatedPosts.length > 0 && (
        <section class="mt-16 pt-10 border-t border-[var(--border-hairline)]">
          <div class="flex items-baseline justify-between mb-6">
            <h2 class="text-sm font-editorial tracking-[0.2em] text-[var(--text-muted)]">
              延伸阅读
            </h2>
            <a href="/blog/" class="text-xs text-[var(--text-muted)] hover:text-[var(--accent-seal)]">
              全部文章 →
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {relatedPosts.map((rp) => <PostCard post={rp} compact />)}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<script>
  const shareBtn = document.getElementById('copy-article-link-btn');
  shareBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      shareBtn.textContent = '已复制 ✓';
      setTimeout(() => {
        shareBtn.textContent = '复制链接';
      }, 1800);
    } catch {
      // ignore
    }
  });
</script>
