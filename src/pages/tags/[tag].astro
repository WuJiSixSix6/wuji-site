---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getTagsMap } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getTagsMap(posts);
  return tags.map((t) => ({
    params: { tag: t.name },
    props: {
      tagName: t.name,
      posts: t.posts,
      allTags: tags,
    },
  }));
}

const { tagName, posts, allTags } = Astro.props;
---

<BaseLayout title={`标签：#${tagName}`} description={`包含 #${tagName} 标签的全部文章。`}>
  <section class="max-w-5xl mx-auto px-5 sm:px-8 pt-8 pb-20">
    <nav class="flex items-center gap-2 text-xs text-[var(--text-muted)] mb-7">
      <a href="/" class="hover:text-[var(--text-primary)]">首页</a>
      <span>/</span>
      <a href="/tags/" class="hover:text-[var(--text-primary)]">标签</a>
      <span>/</span>
      <span class="text-[var(--text-primary)] font-mono">#{tagName}</span>
    </nav>

    <header class="pb-8 border-b border-[var(--border-strong)] mb-8 flex flex-wrap items-baseline justify-between gap-4">
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] font-editorial">
        #{tagName}
      </h1>
      <span class="text-xs font-mono text-[var(--text-muted)]">关联 {posts.length} 篇</span>
    </header>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-8 text-xs font-mono">
      {
        allTags.map((t) => (
          <a
            href={`/tags/${encodeURIComponent(t.name)}/`}
            class:list={[
              'pb-0.5 border-b transition-colors',
              t.name === tagName
                ? 'border-[var(--accent-seal)] text-[var(--accent-seal)] font-semibold'
                : 'border-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)]',
            ]}
          >
            #{t.name}({t.count})
          </a>
        ))
      }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
