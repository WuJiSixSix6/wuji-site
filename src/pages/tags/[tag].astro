---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getTagsMap } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getTagsMap(posts);
  return tags.map((t) => ({
    params: { tag: t.name },
    props: {
      tagName: t.name,
      posts: t.posts,
      allTags: tags,
    },
  }));
}

const { tagName, posts, allTags } = Astro.props;
---

<BaseLayout title={`标签：#${tagName}`} description={`包含 #${tagName} 标签的全部文章。`}>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-20">
    <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-[var(--text-muted)] mb-6">
      <a href="/" class="hover:text-[var(--accent-gold)]">首页</a>
      <span>/</span>
      <a href="/tags" class="hover:text-[var(--accent-gold)]">标签</a>
      <span>/</span>
      <span class="text-[var(--accent-jade)]">#{tagName}</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <p class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--accent-jade)]">
          Tag Archive · 标签聚合
        </p>
        <h1
          class="mt-1.5 text-3xl sm:text-5xl font-bold text-[var(--text-primary)] font-mono"
        >
          #{tagName}
        </h1>
      </div>
      <span class="text-xs font-mono px-4 py-2 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--accent-jade)] self-start sm:self-end">
        关联 {posts.length} 篇文章
      </span>
    </div>

    <div class="flex flex-wrap items-center gap-2 mb-8">
      {
        allTags.map((t) => (
          <a
            href={`/tags/${encodeURIComponent(t.name)}`}
            class:list={[
              'px-3 py-1 rounded-lg text-xs font-mono border transition-all',
              t.name === tagName
                ? 'bg-[var(--accent-jade)] text-[#fbf5ec] border-transparent font-semibold'
                : 'bg-[var(--bg-surface)] text-[var(--text-secondary)] border-[var(--border-hairline)] hover:border-[var(--accent-jade)]/50',
            ]}
          >
            #{t.name} ({t.count})
          </a>
        ))
      }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
