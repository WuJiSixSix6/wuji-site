---
import '../styles/global.css';
import { SITE } from '../data/site';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandSearch from '../components/CommandSearch.astro';
import InkInteractionCanvas from '../components/InkInteractionCanvas.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title = SITE.title,
  description = SITE.heroSubtitle,
  ogType = 'website',
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} | ${SITE.shortTitle}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.shortTitle} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <!-- Chinese Ink Wash Calligraphy & Editorial Serif Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>

    <!-- Prevent theme flash: Default is Xuan Paper Ink Wash (light); .dark is Nocturnal Ink -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('wuji-ink-theme');
        if (stored === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>

  <body class="relative flex flex-col min-h-screen">
    <!-- Subtle Xuan Paper Fiber Grain -->
    <div class="xuan-paper-grain" aria-hidden="true"></div>

    <!-- Global Interactive Brush Trail + Click Ink-Bloom + Drifting Ink Petals -->
    <InkInteractionCanvas />

    <Navbar />

    <main class="relative z-10 flex-1 pt-24">
      <slot />
    </main>

    <Footer />
    <CommandSearch />

    <!-- Image Lightbox Modal -->
    <div
      id="wuji-lightbox"
      class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/85 backdrop-blur-md cursor-zoom-out"
      aria-hidden="true"
    >
      <img
        id="wuji-lightbox-img"
        src=""
        alt=""
        class="max-w-[92vw] max-h-[88vh] rounded-2xl border border-white/15 shadow-2xl object-contain"
      />
    </div>

    <!-- Global Interactive Engine: Code Copy, Lightbox, Scroll Reveal, 3D Tilt Spotlight, Magnetic Buttons -->
    <script>
      // 1. Code block copy buttons
      document.querySelectorAll<HTMLButtonElement>('.wuji-copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const block = btn.closest('.wuji-code-block');
          const codeEl = block?.querySelector('pre code');
          if (!codeEl) return;

          const lines = Array.from(codeEl.querySelectorAll('.line')).map((l) => l.textContent ?? '');
          const text = lines.length > 0 ? lines.join('\n') : codeEl.textContent || '';

          try {
            await navigator.clipboard.writeText(text);
            const label = btn.querySelector('.wuji-copy-label');
            btn.classList.add('copied');
            if (label) label.textContent = '已复制 ✓';
            setTimeout(() => {
              btn.classList.remove('copied');
              if (label) label.textContent = '复制';
            }, 1800);
          } catch {
            // Fallback
          }
        });
      });

      // 2. Image lightbox
      const lightbox = document.getElementById('wuji-lightbox');
      const lightboxImg = document.getElementById('wuji-lightbox-img') as HTMLImageElement | null;
      document.querySelectorAll<HTMLImageElement>('.wuji-prose img').forEach((img) => {
        img.addEventListener('click', () => {
          if (!lightbox || !lightboxImg) return;
          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt;
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
        });
      });
      lightbox?.addEventListener('click', () => {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
      });

      // 3. Scroll-triggered Ink Unfold Reveal (.ink-reveal)
      const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.ink-reveal'));
      if (revealEls.length > 0) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // 4. 3D Perspective Tilt + Radial Ink Spotlight on interactive cards
      if (window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('.wuji-card-interactive').forEach((card) => {
          card.addEventListener('pointermove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            card.style.setProperty('--mx', `${x}px`);
            card.style.setProperty('--my', `${y}px`);
            const rx = ((y / rect.height) - 0.5) * -5.5;
            const ry = ((x / rect.width) - 0.5) * 5.5;
            card.style.transform = `perspective(950px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateY(-3px)`;
          });
          card.addEventListener('pointerleave', () => {
            card.style.transform = '';
          });
        });

        // 5. Magnetic hover pull on .ink-magnetic controls
        document.querySelectorAll<HTMLElement>('.ink-magnetic').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            const rect = el.getBoundingClientRect();
            const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.16;
            const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.16;
            el.style.transform = `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0)`;
          });
          el.addEventListener('pointerleave', () => {
            el.style.transform = '';
          });
        });
      }
    </script>
  </body>
</html>
