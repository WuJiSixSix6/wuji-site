---
/**
 * Publication-Grade Transformer Architecture SVG Diagrams
 * Adapts automatically to Xuan Paper (light) & Inkstone Nocturnal (dark) themes.
 */
interface Props {
  variant: 'overview' | 'attention' | 'rope' | 'kvcache';
  caption?: string;
}
const { variant, caption } = Astro.props;
---

<figure class="my-8 p-5 sm:p-6 border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-[3px]">
  <div class="overflow-x-auto">
    {variant === 'overview' && (
      <svg viewBox="0 0 760 390" class="w-full min-w-[580px] h-auto" role="img" aria-label="Transformer 全景架构演进对比图">
        <defs>
          <marker id="arr-ink" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--text-secondary)" />
          </marker>
          <marker id="arr-seal" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--accent-seal)" />
          </marker>
        </defs>

        <!-- Left Column: Classic 2017 Post-LN -->
        <rect x="20" y="16" width="335" height="356" rx="3" fill="var(--bg-canvas)" stroke="var(--border-hairline)" />
        <text x="187" y="42" text-anchor="middle" font-size="13" font-weight="700" fill="var(--text-primary)" font-family="var(--font-serif)">
          经典 Transformer Block（2017 · Post-LN）
        </text>

        <rect x="92" y="316" width="190" height="34" rx="2" fill="var(--bg-elevated)" stroke="var(--border-strong)" />
        <text x="187" y="337" text-anchor="middle" font-size="11.5" fill="var(--text-primary)">Token Emb + 正弦位置编码</text>

        <line x1="187" y1="316" x2="187" y2="288" stroke="var(--text-secondary)" stroke-width="1.3" marker-end="url(#arr-ink)" />

        <rect x="92" y="246" width="190" height="40" rx="2" fill="var(--bg-surface)" stroke="var(--accent-jade)" stroke-width="1.3" />
        <text x="187" y="270" text-anchor="middle" font-size="12" font-weight="600" fill="var(--text-primary)">Multi-Head Self-Attention</text>

        <!-- Residual 1 -->
        <path d="M 187 302 L 58 302 L 58 214 L 90 214" fill="none" stroke="var(--accent-seal)" stroke-width="1.2" stroke-dasharray="4 3" marker-end="url(#arr-seal)" />
        <line x1="187" y1="246" x2="187" y2="229" stroke="var(--text-secondary)" stroke-width="1.3" marker-end="url(#arr-ink)" />

        <rect x="92" y="198" width="190" height="29" rx="2" fill="var(--bg-elevated)" stroke="var(--border-strong)" />
        <text x="187" y="217" text-anchor="middle" font-size="11.5" fill="var(--text-primary)">Add &amp; LayerNorm</text>

        <line x1="187" y1="198" x2="187" y2="170" stroke="var(--text-secondary)" stroke-width="1.3" marker-end="url(#arr-ink)" />

        <rect x="92" y="128" width="190" height="40" rx="2" fill="var(--bg-surface)" stroke="var(--accent-jade)" stroke-width="1.3" />
        <text x="187" y="152" text-anchor="middle" font-size="12" font-weight="600" fill="var(--text-primary)">FFN (Linear · ReLU · Linear)</text>

        <!-- Residual 2 -->
        <path d="M 187 184 L 58 184 L 58 96 L 90 96" fill="none" stroke="var(--accent-seal)" stroke-width="1.2" stroke-dasharray="4 3" marker-end="url(#arr-seal)" />
        <line x1="187" y1="128" x2="187" y2="111" stroke="var(--text-secondary)" stroke-width="1.3" marker-end="url(#arr-ink)" />

        <rect x="92" y="80" width="190" height="29" rx="2" fill="var(--bg-elevated)" stroke="var(--border-strong)" />
        <text x="187" y="99" text-anchor="middle" font-size="11.5" fill="var(--text-primary)">Add &amp; LayerNorm</text>

        <text x="187" y="64" text-anchor="middle" font-size="10.5" fill="var(--text-muted)">梯度须经 LN，深层训练依赖 Warmup</text>

        <!-- Right Column: Modern LLM Pre-LN Decoder -->
        <rect x="395" y="16" width="345" height="356" rx="3" fill="var(--bg-canvas)" stroke="var(--accent-seal)" stroke-opacity="0.5" />
        <text x="567" y="42" text-anchor="middle" font-size="13" font-weight="700" fill="var(--accent-seal)" font-family="var(--font-serif)">
          现代大语言模型 Block（Pre-LN · RoPE · GQA · SwiGLU）
        </text>

        <rect x="467" y="316" width="205" height="34" rx="2" fill="var(--bg-elevated)" stroke="var(--border-strong)" />
        <text x="569" y="337" text-anchor="middle" font-size="11.5" fill="var(--text-primary)">Token Embedding（无绝对加性 PE）</text>

        <line x1="569" y1="316" x2="569" y2="294" stroke="var(--text-secondary)" stroke-width="1.3" marker-end="url(#arr-ink)" />

        <!-- Pre-RMSNorm 1 -->
        <rect x="467" y="264" width="205" height="28" rx="2" fill="var(--bg-elevated)" stroke="var(--border-strong)" />
        <text x="569" y="282" text-anchor="middle" font-size="11.5" fill="var(--text-primary)">RMSNorm</text>

        <line x1="569" y1="264" x2="569" y2="246" stroke="var(--text-secondary)" stroke-width="1.3" marker-end="url(#arr-ink)" />

        <!-- GQA + RoPE -->
        <rect x="467" y="206" width="205" height="38" rx="2" fill="var(--bg-surface)" stroke="var(--accent-seal)" stroke-width="1.3" />
        <text x="569" y="224" text-anchor="middle" font-size="11.5" font-weight="600" fill="var(--text-primary)">Causal GQA + RoPE + KV Cache</text>
        <text x="569" y="238" text-anchor="middle" font-size="9.5" fill="var(--text-muted)">旋转位置编码注入 Q, K</text>

        <!-- Clean Residual Highway 1 -->
        <path d="M 569 305 L 430 305 L 430 184 L 557 184" fill="none" stroke="var(--accent-seal)" stroke-width="1.5" marker-end="url(#arr-seal)" />
        <line x1="569" y1="206" x2="569" y2="195" stroke="var(--text-secondary)" stroke-width="1.3" />
        <circle cx="569" cy="184" r="10" fill="var(--bg-surface)" stroke="var(--accent-seal)" stroke-width="1.3" />
        <text x="569" y="188" text-anchor="middle" font-size="13" font-weight="700" fill="var(--accent-seal)">+</text>

        <line x1="569" y1="174" x2="569" y2="156" stroke="var(--text-secondary)" stroke-width="1.3" marker-end="url(#arr-ink)" />

        <!-- Pre-RMSNorm 2 -->
        <rect x="467" y="127" width="205" height="27" rx="2" fill="var(--bg-elevated)" stroke="var(--border-strong)" />
        <text x="569" y="145" text-anchor="middle" font-size="11.5" fill="var(--text-primary)">RMSNorm</text>

        <line x1="569" y1="127" x2="569" y2="111" stroke="var(--text-secondary)" stroke-width="1.3" marker-end="url(#arr-ink)" />

        <!-- SwiGLU -->
        <rect x="467" y="75" width="205" height="34" rx="2" fill="var(--bg-surface)" stroke="var(--accent-jade)" stroke-width="1.3" />
        <text x="569" y="96" text-anchor="middle" font-size="11.5" font-weight="600" fill="var(--text-primary)">SwiGLU FFN（门控前馈）</text>

        <!-- Clean Residual Highway 2 -->
        <path d="M 569 166 L 430 166 L 430 58 L 557 58" fill="none" stroke="var(--accent-seal)" stroke-width="1.5" marker-end="url(#arr-seal)" />
        <line x1="569" y1="75" x2="569" y2="68" stroke="var(--text-secondary)" stroke-width="1.3" />
        <circle cx="569" cy="58" r="9" fill="var(--bg-surface)" stroke="var(--accent-seal)" stroke-width="1.3" />
        <text x="569" y="62" text-anchor="middle" font-size="12" font-weight="700" fill="var(--accent-seal)">+</text>
      </svg>
    )}

    {variant === 'attention' && (
      <svg viewBox="0 0 760 310" class="w-full min-w-[580px] h-auto" role="img" aria-label="缩放点积注意力与张量维度流图解">
        <defs>
          <marker id="arr-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--text-secondary)" />
          </marker>
        </defs>

        <!-- Input X -->
        <rect x="18" y="122" width="102" height="62" rx="2" fill="var(--bg-elevated)" stroke="var(--border-strong)" />
        <text x="69" y="148" text-anchor="middle" font-size="12" font-weight="700" fill="var(--text-primary)">输入 X</text>
        <text x="69" y="168" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-muted)">[B, T, d_model]</text>

        <!-- Q K V Projections -->
        <path d="M 120 153 L 154 62" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-a)" />
        <path d="M 120 153 L 154 153" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-a)" />
        <path d="M 120 153 L 154 244" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-a)" />

        <rect x="158" y="38" width="112" height="48" rx="2" fill="var(--bg-canvas)" stroke="var(--accent-seal)" />
        <text x="214" y="59" text-anchor="middle" font-size="12" font-weight="700" fill="var(--accent-seal)">Q = X · W_Q</text>
        <text x="214" y="76" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-muted)">[B, H, T, d_k]</text>

        <rect x="158" y="129" width="112" height="48" rx="2" fill="var(--bg-canvas)" stroke="var(--accent-jade)" />
        <text x="214" y="150" text-anchor="middle" font-size="12" font-weight="700" fill="var(--accent-jade)">K = X · W_K</text>
        <text x="214" y="167" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-muted)">[B, H, T, d_k]</text>

        <rect x="158" y="220" width="112" height="48" rx="2" fill="var(--bg-canvas)" stroke="var(--border-strong)" />
        <text x="214" y="241" text-anchor="middle" font-size="12" font-weight="700" fill="var(--text-primary)">V = X · W_V</text>
        <text x="214" y="258" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-muted)">[B, H, T, d_k]</text>

        <!-- MatMul QK^T / sqrt(dk) -->
        <path d="M 270 62 L 320 98" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-a)" />
        <path d="M 270 153 L 320 116" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-a)" />

        <rect x="324" y="76" width="142" height="62" rx="2" fill="var(--bg-elevated)" stroke="var(--border-strong)" />
        <text x="395" y="100" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--text-primary)">Q · Kᵀ / √d_k</text>
        <text x="395" y="117" text-anchor="middle" font-size="10" fill="var(--accent-seal)">+ 因果下三角掩码 M</text>
        <text x="395" y="131" text-anchor="middle" font-size="9.5" font-family="var(--font-mono)" fill="var(--text-muted)">[B, H, T, T]</text>

        <!-- Softmax -->
        <line x1="466" y1="107" x2="496" y2="107" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-a)" />
        <rect x="500" y="82" width="94" height="50" rx="2" fill="var(--bg-canvas)" stroke="var(--accent-seal)" />
        <text x="547" y="104" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--accent-seal)">Softmax</text>
        <text x="547" y="121" text-anchor="middle" font-size="9.5" fill="var(--text-muted)">注意力权重 A</text>

        <!-- Weighted Sum A * V -->
        <path d="M 547 132 L 547 190" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-a)" />
        <path d="M 270 244 L 496 226" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-a)" />

        <rect x="500" y="194" width="110" height="58" rx="2" fill="var(--bg-elevated)" stroke="var(--accent-jade)" stroke-width="1.3" />
        <text x="555" y="219" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--text-primary)">A · V 加权聚合</text>
        <text x="555" y="238" text-anchor="middle" font-size="9.5" font-family="var(--font-mono)" fill="var(--text-muted)">[B, H, T, d_k]</text>

        <!-- Concat & W_O -->
        <line x1="610" y1="223" x2="640" y2="223" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-a)" />
        <rect x="644" y="194" width="98" height="58" rx="2" fill="var(--bg-canvas)" stroke="var(--border-strong)" />
        <text x="693" y="218" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--text-primary)">Concat · W_O</text>
        <text x="693" y="237" text-anchor="middle" font-size="9.5" font-family="var(--font-mono)" fill="var(--text-muted)">[B, T, d_model]</text>
      </svg>
    )}

    {variant === 'rope' && (
      <svg viewBox="0 0 740 270" class="w-full min-w-[540px] h-auto" role="img" aria-label="RoPE 旋转位置编码二维复平面几何图解">
        <defs>
          <marker id="arr-r1" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--accent-seal)" />
          </marker>
          <marker id="arr-r2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--accent-jade)" />
          </marker>
        </defs>

        <!-- Left: 2D Complex Rotation Plane -->
        <g transform="translate(155, 145)">
          <circle cx="0" cy="0" r="92" fill="none" stroke="var(--border-hairline)" stroke-dasharray="4 4" />
          <line x1="-115" y1="0" x2="115" y2="0" stroke="var(--border-strong)" stroke-width="1" />
          <line x1="0" y1="-115" x2="0" y2="110" stroke="var(--border-strong)" stroke-width="1" />
          <text x="108" y="-6" font-size="10" fill="var(--text-muted)">Re (2i)</text>
          <text x="6" y="-104" font-size="10" fill="var(--text-muted)">Im (2i+1)</text>

          <!-- Vector k rotated by n*theta -->
          <line x1="0" y1="0" x2="76" y2="-44" stroke="var(--accent-jade)" stroke-width="2" marker-end="url(#arr-r2)" />
          <text x="82" y="-48" font-size="11" font-weight="600" fill="var(--accent-jade)">R(nθ)·k</text>

          <!-- Vector q rotated by m*theta -->
          <line x1="0" y1="0" x2="-30" y2="-84" stroke="var(--accent-seal)" stroke-width="2" marker-end="url(#arr-r1)" />
          <text x="-88" y="-88" font-size="11" font-weight="600" fill="var(--accent-seal)">R(mθ)·q</text>

          <!-- Angle Arc (m-n)theta -->
          <path d="M 38 -22 A 44 44 0 0 0 -15 -41" fill="none" stroke="var(--accent-seal)" stroke-width="1.5" />
          <text x="12" y="-50" font-size="10.5" font-weight="700" fill="var(--accent-seal)">(m − n)θ</text>
        </g>

        <!-- Right: Key Mathematical Insight Box -->
        <rect x="330" y="34" width="388" height="204" rx="3" fill="var(--bg-canvas)" stroke="var(--border-hairline)" />
        <text x="352" y="64" font-size="13" font-weight="700" fill="var(--text-primary)" font-family="var(--font-serif)">
          为什么旋转编码天生表达相对距离？
        </text>
        <text x="352" y="96" font-size="11.5" fill="var(--text-secondary)">
          1. 将 d 维向量两两配对为 d/2 个二维子平面，第 i 对频率：
        </text>
        <text x="368" y="118" font-size="11.5" font-family="var(--font-mono)" fill="var(--accent-jade)">
          θ_i = base^(-2i / d)   (高频捕捉近距，低频捕捉远距)
        </text>
        <text x="352" y="148" font-size="11.5" fill="var(--text-secondary)">
          2. 位置 m 的 Query 逆时针旋转 mθ，位置 n 的 Key 旋转 nθ；
        </text>
        <text x="352" y="176" font-size="11.5" fill="var(--text-secondary)">
          3. 两者做内积时，绝对旋转角自动抵消，仅剩相对夹角：
        </text>
        <text x="368" y="200" font-size="12" font-weight="700" font-family="var(--font-mono)" fill="var(--accent-seal)">
          ⟨R(mθ)q, R(nθ)k⟩ = qᵀ · R((n − m)θ) · k
        </text>
        <text x="352" y="224" font-size="10.5" fill="var(--text-muted)">
          零额外可学习参数 · 完美兼容 KV Cache · 易于通过 YaRN/NTK 外推至 1M 上下文
        </text>
      </svg>
    )}

    {variant === 'kvcache' && (
      <svg viewBox="0 0 760 280" class="w-full min-w-[580px] h-auto" role="img" aria-label="自回归推理 Prefill 与 Decode KV Cache 机制图解">
        <defs>
          <marker id="arr-kv" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--text-secondary)" />
          </marker>
        </defs>

        <!-- Phase 1: Prefill -->
        <rect x="16" y="16" width="334" height="248" rx="3" fill="var(--bg-canvas)" stroke="var(--border-hairline)" />
        <text x="183" y="42" text-anchor="middle" font-size="13" font-weight="700" fill="var(--text-primary)" font-family="var(--font-serif)">
          阶段一：Prefill（计算密集 · 并行写入 Cache）
        </text>
        <text x="183" y="64" text-anchor="middle" font-size="10.5" fill="var(--text-muted)">
          一次性并行处理 Prompt 全部 T 个 Token
        </text>

        <rect x="44" y="84" width="278" height="36" rx="2" fill="var(--bg-elevated)" stroke="var(--border-strong)" />
        <text x="183" y="106" text-anchor="middle" font-size="11.5" font-family="var(--font-mono)" fill="var(--text-primary)">
          Q, K, V  [B, H, T, d_k]  并行矩阵乘
        </text>

        <line x1="183" y1="120" x2="183" y2="152" stroke="var(--text-secondary)" stroke-width="1.3" marker-end="url(#arr-kv)" />

        <rect x="44" y="156" width="278" height="44" rx="2" fill="var(--bg-surface)" stroke="var(--accent-jade)" stroke-width="1.3" />
        <text x="183" y="176" text-anchor="middle" font-size="11.5" font-weight="600" fill="var(--accent-jade)">
          写入显存 KV Cache：[K₁..K_T], [V₁..V_T]
        </text>
        <text x="183" y="192" text-anchor="middle" font-size="10" fill="var(--text-muted)">
          生成第 1 个输出 Token（决定 TTFT 首字延迟）
        </text>

        <text x="183" y="238" text-anchor="middle" font-size="10.5" fill="var(--text-secondary)">
          瓶颈：GPU TensorCore 算力（Compute-Bound）
        </text>

        <!-- Phase 2: Decode -->
        <rect x="380" y="16" width="364" height="248" rx="3" fill="var(--bg-canvas)" stroke="var(--accent-seal)" stroke-opacity="0.5" />
        <text x="562" y="42" text-anchor="middle" font-size="13" font-weight="700" fill="var(--accent-seal)" font-family="var(--font-serif)">
          阶段二：Decode（访存密集 · 增量复用 Cache）
        </text>
        <text x="562" y="64" text-anchor="middle" font-size="10.5" fill="var(--text-muted)">
          每步仅计算最新 1 个 Token 的 q_t, k_t, v_t
        </text>

        <rect x="404" y="84" width="136" height="44" rx="2" fill="var(--bg-surface)" stroke="var(--accent-seal)" />
        <text x="472" y="104" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--accent-seal)">新 Token 投影</text>
        <text x="472" y="120" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-muted)">q_t [B, H, 1, d_k]</text>

        <rect x="562" y="84" width="158" height="44" rx="2" fill="var(--bg-elevated)" stroke="var(--accent-jade)" />
        <text x="641" y="104" text-anchor="middle" font-size="11" font-weight="600" fill="var(--accent-jade)">拼接历史 KV Cache</text>
        <text x="641" y="120" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--text-muted)">K[1..t], V[1..t]</text>

        <path d="M 472 128 L 535 162" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-kv)" />
        <path d="M 641 128 L 585 162" stroke="var(--text-secondary)" stroke-width="1.2" marker-end="url(#arr-kv)" />

        <rect x="424" y="166" width="276" height="38" rx="2" fill="var(--bg-surface)" stroke="var(--border-strong)" />
        <text x="562" y="189" text-anchor="middle" font-size="11.5" font-weight="600" fill="var(--text-primary)">
          复杂度由 O(t²) 降至 O(t) · GQA/MLA 压缩 KV 显存
        </text>

        <text x="562" y="238" text-anchor="middle" font-size="10.5" fill="var(--text-secondary)">
          瓶颈：HBM 显存带宽（Memory-Bound · 决定 TPOT）
        </text>
      </svg>
    )}
  </div>
  {caption && (
    <figcaption class="mt-3 text-center text-xs text-[var(--text-muted)] font-editorial">
      {caption}
    </figcaption>
  )}
</figure>
