---
/**
 * Hairline antique cinnabar reading progress line + Square Inkstone Back-to-Top button
 */
---

<div
  id="wuji-reading-progress"
  class="fixed top-0 left-0 h-[2px] z-50 w-0 pointer-events-none transition-[width] duration-75 bg-[var(--accent-seal)]"
  aria-hidden="true"
></div>

<button
  id="wuji-back-top"
  type="button"
  aria-label="返回顶部"
  title="归顶"
  class="fixed bottom-6 right-6 z-40 hidden flex-col items-center justify-center w-10 h-10 rounded-[3px] bg-[var(--bg-surface)] border border-[var(--border-strong)] text-[var(--text-secondary)] hover:border-[var(--accent-seal)] hover:text-[var(--accent-seal)] transition-colors cursor-pointer"
>
  <span class="text-xs font-calligraphy leading-none">归顶</span>
</button>

<script>
  const bar = document.getElementById('wuji-reading-progress');
  const backTop = document.getElementById('wuji-back-top');

  function onScroll() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
    if (bar) bar.style.width = `${pct}%`;

    if (backTop) {
      if (scrollTop > 400) {
        backTop.classList.remove('hidden');
        backTop.classList.add('flex');
      } else {
        backTop.classList.add('hidden');
        backTop.classList.remove('flex');
      }
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  backTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
