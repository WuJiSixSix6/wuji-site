---
/**
 * Whisper-Quiet Song-Dynasty Ink-Wash Shan-Shui Landscape Backdrop
 * Authentic monochrome ink dilutions (焦/浓/重/淡/清), zero flashy orbs,
 * auto-sleeping GPU parallax + persistent interactive ink wash layer.
 */
---

<div
  id="wuji-hero-shanshui"
  class="absolute inset-0 overflow-hidden pointer-events-none select-none"
  style="contain: layout style paint;"
  aria-hidden="true"
>
  <!-- Persistent interactive hero splash layer -->
  <canvas id="wuji-hero-paint-canvas" class="absolute inset-0 w-full h-full opacity-75"></canvas>

  <!-- Distant Mountain Wash (清墨远岫) -->
  <svg
    data-parallax="9"
    class="shanshui-layer absolute bottom-0 left-[-4%] w-[108%] h-[54%] text-[var(--ink-primary)] opacity-[0.045] dark:opacity-[0.08] will-change-transform"
    viewBox="0 0 1440 420"
    preserveAspectRatio="none"
    fill="currentColor"
  >
    <path d="M0,330 C160,260 280,190 420,215 C560,240 660,125 820,145 C980,165 1090,80 1240,120 C1330,145 1390,175 1440,155 L1440,420 L0,420 Z" />
  </svg>

  <!-- Mid-ground Misty Ridge (淡墨云岚) -->
  <svg
    data-parallax="18"
    class="shanshui-layer absolute bottom-0 left-[-4%] w-[108%] h-[38%] text-[var(--accent-jade)] opacity-[0.08] dark:opacity-[0.12] will-change-transform"
    viewBox="0 0 1440 340"
    preserveAspectRatio="none"
    fill="currentColor"
  >
    <path d="M0,255 C190,205 330,270 500,190 C670,115 790,210 960,165 C1120,120 1260,85 1440,160 L1440,340 L0,340 Z" />
  </svg>

  <!-- Foreground Ink Slope (重墨近峰) -->
  <svg
    data-parallax="28"
    class="shanshui-layer absolute bottom-[-2px] left-[-4%] w-[108%] h-[24%] text-[var(--ink-primary)] opacity-[0.09] dark:opacity-[0.14] will-change-transform"
    viewBox="0 0 1440 240"
    preserveAspectRatio="none"
    fill="currentColor"
  >
    <path d="M0,185 C210,130 370,205 565,155 C760,105 910,185 1125,135 C1275,100 1375,145 1440,120 L1440,240 L0,240 Z" />
  </svg>

  <!-- Delicate Pine / Bamboo Sprig on Top-Right Margin -->
  <svg
    data-parallax="20"
    class="shanshui-layer hidden lg:block absolute right-2 top-16 w-56 h-72 text-[var(--ink-primary)] opacity-[0.085] dark:opacity-[0.14] will-change-transform"
    viewBox="0 0 260 320"
    fill="none"
  >
    <path d="M250 310 C228 238 220 165 206 34" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
    <path d="M217 152 C185 130 150 116 112 102" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    <path d="M210 96 C180 78 156 64 124 52" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
    <path d="M150 116 C126 110 104 118 86 134 C110 130 132 124 150 116 Z" fill="currentColor" />
    <path d="M170 124 C146 130 128 146 116 168 C138 156 156 140 170 124 Z" fill="currentColor" />
    <path d="M136 60 C110 50 86 54 64 68 C90 66 114 66 136 60 Z" fill="currentColor" />
    <path d="M164 72 C142 72 120 84 106 102 C130 92 148 82 164 72 Z" fill="currentColor" />
  </svg>

  <!-- Seamless paper fade at bottom -->
  <div
    class="absolute inset-x-0 bottom-0 h-24"
    style="background: linear-gradient(to top, var(--bg-canvas) 0%, transparent 100%);"
  ></div>
</div>

<script>
  const container = document.getElementById('wuji-hero-shanshui');
  const layers = Array.from(document.querySelectorAll<HTMLElement>('.shanshui-layer'));
  const paintCanvas = document.getElementById('wuji-hero-paint-canvas') as HTMLCanvasElement | null;

  if (container && layers.length > 0 && window.matchMedia('(pointer: fine)').matches) {
    let tx = 0;
    let ty = 0;
    let cx = 0;
    let cy = 0;
    let running = false;

    function tick() {
      cx += (tx - cx) * 0.075;
      cy += (ty - cy) * 0.075;
      for (const layer of layers) {
        const depth = Number(layer.dataset.parallax || 16);
        layer.style.transform = `translate3d(${(-cx * depth).toFixed(2)}px, ${(-cy * depth * 0.45).toFixed(2)}px, 0)`;
      }
      if (Math.abs(tx - cx) > 0.0008 || Math.abs(ty - cy) > 0.0008) {
        requestAnimationFrame(tick);
      } else {
        running = false;
      }
    }

    window.addEventListener(
      'pointermove',
      (e) => {
        if (window.scrollY > 720) return;
        tx = e.clientX / Math.max(window.innerWidth, 1) - 0.5;
        ty = e.clientY / Math.max(window.innerHeight, 1) - 0.5;
        if (!running) {
          running = true;
          requestAnimationFrame(tick);
        }
      },
      { passive: true }
    );
  }

  if (paintCanvas) {
    const pctx = paintCanvas.getContext('2d');
    if (pctx) {
      let pw = 0;
      let ph = 0;

      function resizePaint() {
        const rect = paintCanvas!.parentElement?.getBoundingClientRect();
        pw = Math.round(rect ? rect.width : window.innerWidth);
        ph = Math.round(rect ? rect.height : 580);
        paintCanvas!.width = pw;
        paintCanvas!.height = ph;
      }

      function paintHeroSplash(isRed = false) {
        const isDark = document.documentElement.classList.contains('dark');
        const rgb = isRed
          ? isDark
            ? '196, 74, 64'
            : '158, 42, 34'
          : isDark
            ? '226, 221, 210'
            : '28, 27, 24';

        const cx = pw * (0.2 + Math.random() * 0.62);
        const cy = ph * (0.2 + Math.random() * 0.52);
        const maxR = 42 + Math.random() * 78;

        const grad = pctx!.createRadialGradient(cx, cy, maxR * 0.08, cx, cy, maxR);
        grad.addColorStop(0, `rgba(${rgb}, 0.12)`);
        grad.addColorStop(0.55, `rgba(${rgb}, 0.05)`);
        grad.addColorStop(1, `rgba(${rgb}, 0)`);
        pctx!.fillStyle = grad;
        pctx!.beginPath();
        for (let i = 0; i <= 12; i++) {
          const ang = (i / 12) * Math.PI * 2;
          const r = maxR * (0.74 + Math.random() * 0.44);
          const x = cx + Math.cos(ang) * r;
          const y = cy + Math.sin(ang) * r;
          if (i === 0) pctx!.moveTo(x, y);
          else pctx!.lineTo(x, y);
        }
        pctx!.closePath();
        pctx!.fill();

        for (let k = 0; k < 9; k++) {
          const ang = Math.random() * Math.PI * 2;
          const dist = maxR * (0.45 + Math.random() * 0.85);
          pctx!.fillStyle = `rgba(${rgb}, ${0.07 + Math.random() * 0.12})`;
          pctx!.beginPath();
          pctx!.arc(cx + Math.cos(ang) * dist, cy + Math.sin(ang) * dist, 1 + Math.random() * 2.8, 0, Math.PI * 2);
          pctx!.fill();
        }
      }

      resizePaint();
      window.addEventListener('resize', resizePaint, { passive: true });
      window.addEventListener('wuji-hero-splash', ((e: CustomEvent) => paintHeroSplash(Boolean(e.detail?.isRed))) as EventListener);
      window.addEventListener('wuji-hero-clear', () => pctx!.clearRect(0, 0, pw, ph));
    }
  }
</script>
