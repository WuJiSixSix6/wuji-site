---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getCategoriesMap, getTagsMap } from '../../utils/blog';

const posts = await getPublishedPosts();
const categories = getCategoriesMap(posts);
const tags = getTagsMap(posts);
---

<BaseLayout title="全部文章" description="浏览无极 (WuJi) 的全部技术博客、数学笔记与架构文章。">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-16">
    <!-- Header -->
    <div class="max-w-2xl">
      <p class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--accent-gold)]">
        Articles · 全部文章
      </p>
      <h1
        class="mt-2 text-3xl sm:text-5xl font-bold text-[var(--text-primary)]"
        style="font-family: var(--font-serif);"
      >
        思想与代码的沉淀
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
        共收录 <span class="font-mono text-[var(--accent-gold)]">{posts.length}</span> 篇文章，支持按分类、标签或关键词实时筛选。
      </p>
    </div>

    <!-- Filter Toolbar -->
    <div class="mt-10 p-4 sm:p-5 rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] space-y-4">
      <div class="flex flex-col sm:flex-row gap-3 sm:items-center justify-between">
        <!-- Quick Keyword Filter -->
        <div class="relative flex-1 max-w-md">
          <svg class="w-4 h-4 text-[var(--text-muted)] absolute left-3.5 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input
            id="blog-filter-input"
            type="text"
            placeholder="快速过滤当前列表..."
            class="w-full pl-10 pr-4 py-2 rounded-xl text-sm bg-[var(--bg-elevated)] border border-[var(--border-hairline)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-gold)]/50"
          />
        </div>

        <!-- Sort + Counter -->
        <div class="flex items-center gap-3">
          <select
            id="blog-sort-select"
            aria-label="排序方式"
            class="px-3 py-2 rounded-xl text-xs font-medium bg-[var(--bg-elevated)] border border-[var(--border-hairline)] text-[var(--text-secondary)] focus:outline-none focus:border-[var(--accent-gold)]/50 cursor-pointer"
          >
            <option value="default">默认排序（置顶优先）</option>
            <option value="newest">最新发布</option>
            <option value="oldest">最早发布</option>
            <option value="longest">深度长文优先</option>
          </select>
          <span id="blog-visible-count" class="text-xs font-mono text-[var(--text-muted)] whitespace-nowrap">
            显示 {posts.length} 篇
          </span>
        </div>
      </div>

      <!-- Category Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-1" id="blog-cat-pills">
        <button
          type="button"
          data-cat="ALL"
          class="cat-pill px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer bg-[var(--accent-gold)] text-[#08090c]"
        >
          全部 ({posts.length})
        </button>
        {
          categories.map((cat) => (
            <button
              type="button"
              data-cat={cat.name}
              class="cat-pill px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer bg-[var(--bg-elevated)] text-[var(--text-secondary)] border border-[var(--border-hairline)] hover:border-[var(--accent-gold)]/40 hover:text-[var(--text-primary)]"
            >
              {cat.name} ({cat.count})
            </button>
          ))
        }
      </div>

      <!-- Hot Tags Strip -->
      <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-[var(--border-hairline)]">
        <span class="text-[11px] font-mono text-[var(--text-muted)] mr-1">热门标签:</span>
        {
          tags.slice(0, 10).map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag.name)}`}
              class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-[var(--bg-elevated)] text-[var(--text-muted)] hover:text-[var(--accent-jade)] border border-[var(--border-hairline)] transition-colors"
            >
              #{tag.name}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Posts Grid -->
    <div id="blog-posts-grid" class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <!-- Empty State -->
    <div id="blog-empty-state" class="hidden py-20 text-center space-y-2">
      <p class="text-base text-[var(--text-secondary)]">没有找到符合条件的文章</p>
      <button
        id="blog-reset-btn"
        type="button"
        class="text-xs font-medium text-[var(--accent-gold)] hover:underline cursor-pointer"
      >
        重置筛选条件
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  const grid = document.getElementById('blog-posts-grid');
  const input = document.getElementById('blog-filter-input') as HTMLInputElement | null;
  const sortSelect = document.getElementById('blog-sort-select') as HTMLSelectElement | null;
  const countEl = document.getElementById('blog-visible-count');
  const emptyEl = document.getElementById('blog-empty-state');
  const resetBtn = document.getElementById('blog-reset-btn');
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-pill'));
  const cards = grid ? Array.from(grid.children) as HTMLElement[] : [];

  let activeCat = 'ALL';

  function applyFilters() {
    const q = (input?.value || '').trim().toLowerCase();
    const sortMode = sortSelect?.value || 'default';

    // Sort first
    const ordered = [...cards];
    if (sortMode === 'newest') {
      ordered.sort((a, b) => Number(b.dataset.date) - Number(a.dataset.date));
    } else if (sortMode === 'oldest') {
      ordered.sort((a, b) => Number(a.dataset.date) - Number(b.dataset.date));
    } else if (sortMode === 'longest') {
      ordered.sort((a, b) => Number(b.dataset.reading) - Number(a.dataset.reading));
    }
    ordered.forEach((el) => grid?.appendChild(el));

    let visible = 0;
    for (const card of ordered) {
      const cat = card.dataset.category || '';
      const title = card.dataset.title || '';
      const summary = card.dataset.summary || '';
      const tags = (card.dataset.tags || '').toLowerCase();

      const catOk = activeCat === 'ALL' || cat === activeCat;
      const queryOk = !q || title.includes(q) || summary.includes(q) || tags.includes(q) || cat.toLowerCase().includes(q);
      const show = catOk && queryOk;

      card.classList.toggle('hidden', !show);
      if (show) visible++;
    }

    if (countEl) countEl.textContent = `显示 ${visible} 篇`;
    emptyEl?.classList.toggle('hidden', visible > 0);
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeCat = pill.dataset.cat || 'ALL';
      pills.forEach((p) => {
        const isCurrent = p === pill;
        p.className = isCurrent
          ? 'cat-pill px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer bg-[var(--accent-gold)] text-[#08090c]'
          : 'cat-pill px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all cursor-pointer bg-[var(--bg-elevated)] text-[var(--text-secondary)] border border-[var(--border-hairline)] hover:border-[var(--accent-gold)]/40 hover:text-[var(--text-primary)]';
      });
      applyFilters();
    });
  });

  input?.addEventListener('input', applyFilters);
  sortSelect?.addEventListener('change', applyFilters);
  resetBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    if (sortSelect) sortSelect.value = 'default';
    pills[0]?.click();
  });
</script>
