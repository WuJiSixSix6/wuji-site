---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagsMap } from '../../utils/blog';

const posts = await getPublishedPosts();
const tags = getTagsMap(posts);
const maxCount = Math.max(1, ...tags.map((t) => t.count));
---

<BaseLayout title="标签云" description="通过标签探索无极 (WuJi) 的全部技术笔记与文章主题。">
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 pb-20">
    <div class="max-w-2xl mb-12">
      <p class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--accent-jade)]">
        Tags · 知识标签云
      </p>
      <h1
        class="mt-2 text-3xl sm:text-5xl font-bold text-[var(--text-primary)]"
        style="font-family: var(--font-serif);"
      >
        多维灵感脉络
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[var(--text-secondary)]">
        共沉淀 <span class="font-mono text-[var(--accent-jade)]">{tags.length}</span> 个知识标签，点击任意标签即可聚合对应主题文章。
      </p>
    </div>

    <div class="wuji-card p-7 sm:p-10">
      <div class="flex flex-wrap items-center gap-3">
        {
          tags.map((tag) => {
            const weight = tag.count / maxCount;
            const sizeClass =
              weight >= 0.8
                ? 'text-lg px-4 py-2 font-semibold border-[var(--accent-gold)]/45 bg-[var(--accent-gold-soft)] text-[var(--accent-gold)]'
                : weight >= 0.45
                  ? 'text-base px-3.5 py-1.5 font-medium border-[var(--accent-jade)]/35 bg-[var(--accent-jade-soft)] text-[var(--accent-jade)]'
                  : 'text-sm px-3 py-1.5 border-[var(--border-hairline)] bg-[var(--bg-elevated)] text-[var(--text-secondary)]';
            return (
              <a
                href={`/tags/${encodeURIComponent(tag.name)}`}
                class:list={[
                  'inline-flex items-center gap-2 rounded-xl border hover:-translate-y-0.5 hover:border-[var(--accent-gold)] transition-all',
                  sizeClass,
                ]}
              >
                <span class="font-mono">#{tag.name}</span>
                <span class="text-[11px] font-mono opacity-70">{tag.count}</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
