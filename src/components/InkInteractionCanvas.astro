---
/**
 * Ultra-Lightweight, Auto-Sleeping Chinese Ink Wash Interactive Effects Canvas
 * - Runs at 1x resolution (4x less GPU fillrate on Retina, identically soft watercolor look)
 * - Auto-pauses rAF completely (0% CPU/GPU) once ink trails/blooms/petals settle
 * - Instant wake on pointer move, click, splash, or seal stamp
 */
---

<canvas
  id="wuji-ink-fx-canvas"
  class="fixed inset-0 w-full h-full pointer-events-none z-30"
  aria-hidden="true"
></canvas>

<script>
  const canvas = document.getElementById('wuji-ink-fx-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true });
    if (ctx) {
      let width = window.innerWidth;
      let height = window.innerHeight;
      let enabled = localStorage.getItem('wuji-ink-fx') !== 'off';
      let rafId = 0;
      let running = false;

      const pointer = { x: -999, y: -999, active: false };

      interface TrailSegment {
        x1: number;
        y1: number;
        x2: number;
        y2: number;
        width: number;
        alpha: number;
        isRed: boolean;
      }

      interface InkBloom {
        x: number;
        y: number;
        r: number;
        maxR: number;
        alpha: number;
        isRed: boolean;
      }

      interface InkRipple {
        x: number;
        y: number;
        r: number;
        maxR: number;
        alpha: number;
        isRed: boolean;
      }

      interface InkDroplet {
        x: number;
        y: number;
        vx: number;
        vy: number;
        r: number;
        alpha: number;
        isRed: boolean;
        isLeaf?: boolean;
        rot?: number;
        vrot?: number;
      }

      interface FloatingSeal {
        x: number;
        y: number;
        text: string;
        scale: number;
        alpha: number;
        rot: number;
      }

      const trails: TrailSegment[] = [];
      const blooms: InkBloom[] = [];
      const ripples: InkRipple[] = [];
      const droplets: InkDroplet[] = [];
      const seals: FloatingSeal[] = [];

      function resize() {
        width = window.innerWidth;
        height = window.innerHeight;
        // 1x buffer for soft ink washes = 4x faster on Retina displays
        canvas!.width = width;
        canvas!.height = height;
      }

      function getRgb(isRed: boolean) {
        const isDark = document.documentElement.classList.contains('dark');
        if (isRed) return isDark ? '222, 76, 68' : '185, 43, 39';
        return isDark ? '218, 224, 226' : '24, 28, 31';
      }

      function wake() {
        if (!running && enabled) {
          running = true;
          rafId = requestAnimationFrame(draw);
        }
      }

      function spawnInkSplash(x: number, y: number, isRed = false, big = false) {
        if (!enabled) return;
        blooms.push({
          x,
          y,
          r: big ? 10 : 5,
          maxR: big ? 78 : 38,
          alpha: big ? 0.24 : 0.18,
          isRed,
        });
        if (big) {
          blooms.push({
            x: x + (Math.random() - 0.5) * 60,
            y: y + (Math.random() - 0.5) * 45,
            r: 8,
            maxR: 54,
            alpha: 0.2,
            isRed: !isRed,
          });
        }

        ripples.push({
          x,
          y,
          r: 6,
          maxR: big ? 120 : 64,
          alpha: 0.3,
          isRed,
        });

        const count = big ? 18 : 8;
        for (let i = 0; i < count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = (big ? 2.1 : 1.1) + Math.random() * (big ? 4.4 : 2.6);
          const isLeaf = i % 3 === 0;
          droplets.push({
            x,
            y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            r: isLeaf ? 3.5 + Math.random() * 3.5 : 1.2 + Math.random() * 2.4,
            alpha: 0.52 + Math.random() * 0.28,
            isRed: isRed || (big && i % 4 === 0),
            isLeaf,
            rot: Math.random() * Math.PI * 2,
            vrot: (Math.random() - 0.5) * 0.08,
          });
        }
        wake();
      }

      function spawnStamp(x: number, y: number, text = '无极') {
        if (!enabled) return;
        seals.push({
          x,
          y,
          text,
          scale: 1.65,
          alpha: 0.95,
          rot: (Math.random() - 0.5) * 0.22,
        });
        spawnInkSplash(x, y, true, false);
        wake();
      }

      function onPointerMove(e: PointerEvent) {
        if (!enabled) return;
        const x = e.clientX;
        const y = e.clientY;

        if (pointer.active) {
          const dist = Math.hypot(x - pointer.x, y - pointer.y);
          if (dist > 3.5) {
            const w = Math.max(1.2, Math.min(6.5, 8.2 - dist * 0.12));
            trails.push({
              x1: pointer.x,
              y1: pointer.y,
              x2: x,
              y2: y,
              width: w,
              alpha: 0.24,
              isRed: false,
            });
            if (trails.length > 36) trails.shift();

            // Gentle ink petal / bamboo wisp spawned along sweeping brush movement
            if (dist > 24 && Math.random() < 0.28 && droplets.length < 40) {
              droplets.push({
                x,
                y,
                vx: (Math.random() - 0.5) * 1.1,
                vy: 0.4 + Math.random() * 0.7,
                r: 3 + Math.random() * 3.2,
                alpha: 0.34,
                isRed: Math.random() < 0.22,
                isLeaf: true,
                rot: Math.random() * Math.PI * 2,
                vrot: (Math.random() - 0.5) * 0.05,
              });
            }
            wake();
          }
        }
        pointer.x = x;
        pointer.y = y;
        pointer.active = true;
      }

      function onPointerDown(e: PointerEvent) {
        if (!enabled) return;
        const tag = (e.target as HTMLElement)?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
        const isInteractive = Boolean((e.target as HTMLElement)?.closest('a, button'));
        spawnInkSplash(e.clientX, e.clientY, isInteractive, false);
      }

      function draw() {
        ctx!.clearRect(0, 0, width, height);

        // 1. Brush trail
        ctx!.lineCap = 'round';
        for (let i = trails.length - 1; i >= 0; i--) {
          const s = trails[i];
          s.alpha -= 0.012;
          s.width *= 0.98;
          if (s.alpha <= 0.008) {
            trails.splice(i, 1);
            continue;
          }
          ctx!.strokeStyle = `rgba(${getRgb(s.isRed)}, ${s.alpha})`;
          ctx!.lineWidth = s.width;
          ctx!.beginPath();
          ctx!.moveTo(s.x1, s.y1);
          ctx!.lineTo(s.x2, s.y2);
          ctx!.stroke();
        }

        // 2. Soft concentric ink blooms (no expensive gradient allocation per frame)
        for (let i = blooms.length - 1; i >= 0; i--) {
          const b = blooms[i];
          b.r += (b.maxR - b.r) * 0.1;
          b.alpha -= 0.006;
          if (b.alpha <= 0.006) {
            blooms.splice(i, 1);
            continue;
          }
          const rgb = getRgb(b.isRed);
          ctx!.fillStyle = `rgba(${rgb}, ${b.alpha * 0.45})`;
          ctx!.beginPath();
          ctx!.arc(b.x, b.y, b.r, 0, Math.PI * 2);
          ctx!.fill();
          ctx!.fillStyle = `rgba(${rgb}, ${b.alpha * 0.7})`;
          ctx!.beginPath();
          ctx!.arc(b.x, b.y, b.r * 0.56, 0, Math.PI * 2);
          ctx!.fill();
        }

        // 3. Water-ink ripples
        for (let i = ripples.length - 1; i >= 0; i--) {
          const r = ripples[i];
          r.r += (r.maxR - r.r) * 0.095;
          r.alpha -= 0.009;
          if (r.alpha <= 0.006) {
            ripples.splice(i, 1);
            continue;
          }
          ctx!.strokeStyle = `rgba(${getRgb(r.isRed)}, ${r.alpha})`;
          ctx!.lineWidth = 1.2;
          ctx!.beginPath();
          ctx!.arc(r.x, r.y, r.r, 0, Math.PI * 2);
          ctx!.stroke();
        }

        // 4. Ink droplets & bamboo petals
        for (let i = droplets.length - 1; i >= 0; i--) {
          const d = droplets[i];
          d.x += d.vx;
          d.y += d.vy;
          d.vx *= 0.94;
          d.vy = d.vy * 0.94 + 0.04;
          d.alpha -= d.isLeaf ? 0.009 : 0.016;
          if (d.alpha <= 0.01) {
            droplets.splice(i, 1);
            continue;
          }
          ctx!.fillStyle = `rgba(${getRgb(d.isRed)}, ${d.alpha})`;
          if (d.isLeaf) {
            d.rot = (d.rot || 0) + (d.vrot || 0);
            ctx!.save();
            ctx!.translate(d.x, d.y);
            ctx!.rotate(d.rot);
            ctx!.beginPath();
            ctx!.ellipse(0, 0, d.r, d.r * 0.36, 0, 0, Math.PI * 2);
            ctx!.fill();
            ctx!.restore();
          } else {
            ctx!.beginPath();
            ctx!.arc(d.x, d.y, d.r, 0, Math.PI * 2);
            ctx!.fill();
          }
        }

        // 5. Animated vermilion seals
        for (let i = seals.length - 1; i >= 0; i--) {
          const s = seals[i];
          s.scale += (1 - s.scale) * 0.2;
          s.alpha -= 0.0065;
          if (s.alpha <= 0.01) {
            seals.splice(i, 1);
            continue;
          }
          ctx!.save();
          ctx!.translate(s.x, s.y);
          ctx!.rotate(s.rot);
          ctx!.scale(s.scale, s.scale);
          ctx!.globalAlpha = Math.min(1, s.alpha * 1.15);
          ctx!.fillStyle = 'rgba(185, 43, 39, 0.92)';
          ctx!.strokeStyle = 'rgba(255, 236, 224, 0.55)';
          ctx!.lineWidth = 1.5;
          ctx!.beginPath();
          ctx!.roundRect(-24, -24, 48, 48, 6);
          ctx!.fill();
          ctx!.stroke();
          ctx!.fillStyle = '#fbf4ea';
          ctx!.font = '600 18px "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", serif';
          ctx!.textAlign = 'center';
          ctx!.textBaseline = 'middle';
          ctx!.fillText(s.text, 0, 1);
          ctx!.restore();
        }

        // Auto-sleep when idle!
        const hasWork =
          trails.length > 0 ||
          blooms.length > 0 ||
          ripples.length > 0 ||
          droplets.length > 0 ||
          seals.length > 0;

        if (hasWork && enabled) {
          rafId = requestAnimationFrame(draw);
        } else {
          running = false;
          ctx!.clearRect(0, 0, width, height);
        }
      }

      resize();
      window.addEventListener('resize', resize, { passive: true });
      window.addEventListener('pointermove', onPointerMove, { passive: true });
      window.addEventListener('pointerdown', onPointerDown, { passive: true });

      window.addEventListener('wuji-ink-toggle', ((e: CustomEvent) => {
        enabled = Boolean(e.detail?.enabled);
        if (!enabled) {
          trails.length = 0;
          blooms.length = 0;
          ripples.length = 0;
          droplets.length = 0;
          seals.length = 0;
          if (rafId) cancelAnimationFrame(rafId);
          running = false;
          ctx!.clearRect(0, 0, width, height);
        }
      }) as EventListener);

      window.addEventListener('wuji-ink-splash', ((e: CustomEvent) => {
        const d = e.detail || {};
        spawnInkSplash(
          d.x ?? width * (0.3 + Math.random() * 0.45),
          d.y ?? height * (0.22 + Math.random() * 0.42),
          Boolean(d.isRed),
          d.big !== false
        );
      }) as EventListener);

      window.addEventListener('wuji-stamp-effect', ((e: CustomEvent) => {
        const d = e.detail || {};
        spawnStamp(
          d.x ?? width * (0.52 + Math.random() * 0.25),
          d.y ?? height * (0.26 + Math.random() * 0.34),
          d.text || '无极'
        );
      }) as EventListener);
    }
  }
</script>
