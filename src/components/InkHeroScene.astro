---
/**
 * 《宋画天时图》Living Seasonal & Astronomical Chinese Ink-Wash Hero Canvas
 * - Real-time Sun & Moon trajectory calculated from local clock (hours + minutes)
 * - Accurate Lunar Phase rendering via synodic month epoch calculation
 * - Exact Chinese 24 Solar Terms (二十四节气) + 12 Shichen (十二时辰)
 * - 4-Season ink-wash representative motifs:
 *     春: 落花微瓣 + 远空归燕
 *     夏: 江南细雨（昼） / 晚竹流萤（夜）
 *     秋: 疏林霜枫 + 远天雁阵
 *     冬: 寒山清雪 + 疏枝墨梅
 * - Performance-first: 1x canvas, IntersectionObserver auto-pause when scrolled offscreen,
 *   visibilitychange pause, zero external assets.
 */
---

<div
  id="wuji-hero-shanshui"
  class="fixed inset-0 z-0 overflow-hidden pointer-events-none select-none"
  style="contain: layout style paint;"
  aria-hidden="true"
>
  <!-- Consolidated Astronomical + Seasonal + Splash Canvas -->
  <canvas id="wuji-celestial-canvas" class="absolute inset-0 w-full h-full"></canvas>

  <!-- Distant Mountain Wash (清墨远岫) -->
  <svg
    data-parallax="8"
    class="shanshui-layer absolute bottom-0 left-[-4%] w-[108%] h-[52%] text-[var(--ink-primary)] opacity-[0.048] dark:opacity-[0.085] will-change-transform"
    viewBox="0 0 1440 420"
    preserveAspectRatio="none"
    fill="currentColor"
  >
    <path d="M0,330 C160,260 280,190 420,215 C560,240 660,125 820,145 C980,165 1090,80 1240,120 C1330,145 1390,175 1440,155 L1440,420 L0,420 Z" />
  </svg>

  <!-- Mid-ground Misty Ridge (淡墨云岚) -->
  <svg
    data-parallax="16"
    class="shanshui-layer absolute bottom-0 left-[-4%] w-[108%] h-[36%] text-[var(--accent-jade)] opacity-[0.08] dark:opacity-[0.12] will-change-transform"
    viewBox="0 0 1440 340"
    preserveAspectRatio="none"
    fill="currentColor"
  >
    <path d="M0,255 C190,205 330,270 500,190 C670,115 790,210 960,165 C1120,120 1260,85 1440,160 L1440,340 L0,340 Z" />
  </svg>

  <!-- Foreground Ink Slope (重墨近峰) -->
  <svg
    data-parallax="24"
    class="shanshui-layer absolute bottom-[-2px] left-[-4%] w-[108%] h-[22%] text-[var(--ink-primary)] opacity-[0.085] dark:opacity-[0.14] will-change-transform"
    viewBox="0 0 1440 240"
    preserveAspectRatio="none"
    fill="currentColor"
  >
    <path d="M0,185 C210,130 370,205 565,155 C760,105 910,185 1125,135 C1275,100 1375,145 1440,120 L1440,240 L0,240 Z" />
  </svg>

  <!-- Seasonal Corner Botanical Silhouette (四时角枝：春柳/夏竹/秋枝/冬梅) -->
  <svg
    id="wuji-season-branch"
    data-parallax="18"
    class="shanshui-layer hidden lg:block absolute right-0 top-14 w-64 h-72 will-change-transform"
    viewBox="0 0 260 300"
    fill="none"
  ></svg>

  <!-- Seamless bottom fade into canvas -->
  <div
    class="absolute inset-x-0 bottom-0 h-24"
    style="background: linear-gradient(to top, var(--bg-canvas) 0%, transparent 100%);"
  ></div>
</div>

<script>
  // =========================================================
  // 1. Astronomical & Chinese Calendar Utilities
  // =========================================================
  type SeasonKey = 'spring' | 'summer' | 'autumn' | 'winter';

  interface SkySnapshot {
    date: Date;
    season: SeasonKey;
    seasonCN: string;
    solarTerm: string;
    shichen: string;
    moonPhase: number; // 0 = new, 0.5 = full, 1 = new
    moonName: string;
    festival: string;
    hourFloat: number;
    isDay: boolean;
    label: string;
  }

  const SOLAR_TERMS: Array<[number, number, string]> = [
    [1, 5, '小寒'], [1, 20, '大寒'], [2, 4, '立春'], [2, 19, '雨水'],
    [3, 5, '惊蛰'], [3, 20, '春分'], [4, 4, '清明'], [4, 20, '谷雨'],
    [5, 5, '立夏'], [5, 21, '小满'], [6, 5, '芒种'], [6, 21, '夏至'],
    [7, 7, '小暑'], [7, 22, '大暑'], [8, 7, '立秋'], [8, 23, '处暑'],
    [9, 7, '白露'], [9, 22, '秋分'], [10, 8, '寒露'], [10, 23, '霜降'],
    [11, 7, '立冬'], [11, 22, '小雪'], [12, 7, '大雪'], [12, 21, '冬至'],
  ];

  const SHICHEN_LIST = ['子时', '丑时', '寅时', '卯时', '辰时', '巳时', '午时', '未时', '申时', '酉时', '戌时', '亥时'];

  function getSolarTerm(m: number, d: number): string {
    const md = m * 100 + d;
    let term = '冬至';
    for (const [tm, td, name] of SOLAR_TERMS) {
      if (md >= tm * 100 + td) term = name;
    }
    return term;
  }

  function getSeason(m: number, d: number): { key: SeasonKey; cn: string } {
    const md = m * 100 + d;
    if (md >= 204 && md < 505) return { key: 'spring', cn: '春' };
    if (md >= 505 && md < 807) return { key: 'summer', cn: '夏' };
    if (md >= 807 && md < 1107) return { key: 'autumn', cn: '秋' };
    return { key: 'winter', cn: '冬' };
  }

  function getShichen(hour: number): string {
    const idx = Math.floor(((hour + 1) % 24) / 2);
    return SHICHEN_LIST[idx] || '子时';
  }

  function getMoonPhase(date: Date): { phase: number; name: string } {
    // Synodic month = 29.53058867 days; known New Moon: 2000-01-06 18:14 UTC
    const synodic = 29.53058867;
    const knownNew = Date.UTC(2000, 0, 6, 18, 14, 0);
    const days = (date.getTime() - knownNew) / 86400000;
    const phase = ((days % synodic) + synodic) % synodic / synodic;
    let name = '朔月';
    if (phase < 0.04 || phase >= 0.96) name = '新月';
    else if (phase < 0.22) name = '蛾眉月';
    else if (phase < 0.28) name = '上弦月';
    else if (phase < 0.46) name = '盈凸月';
    else if (phase < 0.54) name = '望月';
    else if (phase < 0.72) name = '亏凸月';
    else if (phase < 0.78) name = '下弦月';
    else name = '残月';
    return { phase, name };
  }

  function getSpecialFestival(m: number, d: number, moonPhase: number): string {
    if (m === 1 && d === 1) return '元旦';
    if (m === 4 && (d === 4 || d === 5)) return '清明';
    if (m === 6 && d >= 20 && d <= 22) return '夏至';
    if (m === 9 && d >= 21 && d <= 24) return '秋分';
    if (m === 12 && d >= 20 && d <= 23) return '冬至';
    if (moonPhase >= 0.46 && moonPhase <= 0.54) return '满月';
    return '';
  }

  function buildSnapshot(date: Date, modeLabel?: string): SkySnapshot {
    const m = date.getMonth() + 1;
    const d = date.getDate();
    const hourFloat = date.getHours() + date.getMinutes() / 60;
    const { key: season, cn: seasonCN } = getSeason(m, d);
    const solarTerm = getSolarTerm(m, d);
    const shichen = getShichen(date.getHours());
    const { phase: moonPhase, name: moonName } = getMoonPhase(date);
    const festival = getSpecialFestival(m, d, moonPhase);
    const isDay = hourFloat >= 5.5 && hourFloat < 18.5;

    const motifHint =
      season === 'spring'
        ? '落花归燕'
        : season === 'summer'
          ? isDay
            ? '烟雨夏荷'
            : '竹影流萤'
          : season === 'autumn'
            ? '霜枫南雁'
            : '疏梅清雪';

    const prefix = modeLabel ? `${modeLabel} · ` : '';
    const astroPart = isDay ? shichen : `${shichen} · ${moonName}`;
    const label = `${prefix}${seasonCN} · ${solarTerm} · ${astroPart} · ${motifHint}`;

    return { date, season, seasonCN, solarTerm, shichen, moonPhase, moonName, festival, hourFloat, isDay, label };
  }

  // Preview presets for interactive "观四时" button
  const PRESETS: Array<{ name: string; build: () => SkySnapshot }> = [
    { name: '实时', build: () => buildSnapshot(new Date()) },
    { name: '春晨', build: () => buildSnapshot(new Date(2026, 3, 5, 7, 15), '景·春晨') },
    { name: '夏夜', build: () => buildSnapshot(new Date(2026, 6, 15, 22, 10), '景·夏夜') },
    { name: '秋暮', build: () => buildSnapshot(new Date(2026, 9, 24, 17, 25), '景·秋暮') },
    { name: '冬望', build: () => buildSnapshot(new Date(2026, 11, 21, 23, 30), '景·冬望') },
  ];
  let presetIdx = Number(sessionStorage.getItem('wuji-sky-preset') || 0);
  if (Number.isNaN(presetIdx) || presetIdx < 0 || presetIdx >= PRESETS.length) presetIdx = 0;

  // =========================================================
  // 2. Seasonal Corner Ink Branch SVG (春柳 / 夏竹 / 秋枝 / 冬梅)
  // =========================================================
  const branchSvg = document.getElementById('wuji-season-branch');

  function renderSeasonBranch(season: SeasonKey) {
    if (!branchSvg) return;
    if (season === 'winter') {
      // 寒梅疏枝 + 朱砂点梅
      branchSvg.innerHTML = `
        <g stroke="currentColor" class="text-[var(--ink-primary)]" opacity="0.22" stroke-linecap="round">
          <path d="M262 24 C222 52 192 86 142 108 C114 120 92 124 64 142" stroke-width="3.1"/>
          <path d="M188 74 C168 48 152 34 126 22" stroke-width="1.8"/>
          <path d="M150 102 C142 132 128 154 106 176" stroke-width="1.6"/>
          <path d="M116 122 C96 102 82 94 62 88" stroke-width="1.2"/>
        </g>
        <g fill="var(--accent-seal)" opacity="0.62">
          <circle cx="142" cy="108" r="3.4"/>
          <circle cx="126" cy="24" r="2.8"/>
          <circle cx="106" cy="174" r="3.1"/>
          <circle cx="72" cy="138" r="2.9"/>
          <circle cx="174" cy="54" r="2.3"/>
          <circle cx="88" cy="98" r="2.2"/>
        </g>
      `;
    } else if (season === 'spring') {
      // 垂柳细丝 + 浅杏花点
      branchSvg.innerHTML = `
        <g stroke="currentColor" class="text-[var(--accent-jade)]" opacity="0.22" stroke-linecap="round">
          <path d="M260 12 C222 36 184 52 138 62" stroke-width="2.6"/>
          <path d="M234 28 C222 86 218 148 228 214" stroke-width="1.1"/>
          <path d="M204 42 C188 102 184 164 196 238" stroke-width="1.15"/>
          <path d="M172 52 C156 108 154 166 164 222" stroke-width="1"/>
          <path d="M144 60 C130 106 126 150 134 194" stroke-width="0.9"/>
        </g>
        <g fill="#b55d55" opacity="0.45">
          <circle cx="192" cy="128" r="2.5"/>
          <circle cx="160" cy="156" r="2.2"/>
          <circle cx="224" cy="166" r="2.3"/>
        </g>
      `;
    } else if (season === 'summer') {
      // 清雅墨竹
      branchSvg.innerHTML = `
        <g class="text-[var(--ink-primary)]" opacity="0.18">
          <path d="M248 292 C228 222 220 154 206 28" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
          <path d="M216 146 C184 126 150 112 114 98" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          <path d="M210 92 C180 74 156 60 124 48" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M150 112 C126 106 104 114 86 130 C110 126 132 120 150 112 Z" fill="currentColor"/>
          <path d="M170 120 C146 126 128 142 116 164 C138 152 156 136 170 120 Z" fill="currentColor"/>
          <path d="M136 56 C110 46 86 50 64 64 C90 62 114 62 136 56 Z" fill="currentColor"/>
          <path d="M164 68 C142 68 120 80 106 98 C130 88 148 78 164 68 Z" fill="currentColor"/>
        </g>
      `;
    } else {
      // 秋枝霜枫
      branchSvg.innerHTML = `
        <g stroke="currentColor" class="text-[var(--ink-primary)]" opacity="0.2" stroke-linecap="round">
          <path d="M262 34 C220 62 184 84 132 104" stroke-width="2.6"/>
          <path d="M192 78 C174 108 156 128 134 152" stroke-width="1.5"/>
          <path d="M164 90 C142 68 122 58 98 52" stroke-width="1.3"/>
        </g>
        <g fill="var(--accent-seal)" opacity="0.5">
          <path d="M132 104 l-7 -4 l3 7 l-7 3 l8 3 l-2 7 l6 -5 l6 4 l-2 -7 l7 -3 l-7 -3 l2 -7 z"/>
          <path d="M104 54 l-5 -3 l2 5 l-5 2 l6 2 l-1 5 l4 -4 l5 3 l-1 -5 l5 -2 l-5 -2 l1 -5 z"/>
          <path d="M142 148 l-5 -3 l2 5 l-5 2 l6 2 l-1 5 l4 -4 l5 3 l-1 -5 l5 -2 l-5 -2 l1 -5 z"/>
        </g>
      `;
    }
  }

  // =========================================================
  // 3. Living Astronomical & Seasonal Canvas Engine
  // =========================================================
  const heroWrap = document.getElementById('wuji-hero-shanshui');
  const canvas = document.getElementById('wuji-celestial-canvas') as HTMLCanvasElement | null;
  const layers = Array.from(document.querySelectorAll<HTMLElement>('.shanshui-layer'));

  if (canvas && heroWrap) {
    const ctx = canvas.getContext('2d', { alpha: true });
    if (ctx) {
      let w = 0;
      let h = 0;
      let inView = true;
      let tabVisible = !document.hidden;
      let rafId = 0;
      let lastFrame = 0;
      let snapshot = PRESETS[presetIdx].build();

      interface SeasonalParticle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        size: number;
        rot: number;
        vrot: number;
        phase: number;
        alpha: number;
        tint: number;
      }

      interface Bird {
        x: number;
        y: number;
        vx: number;
        wingPhase: number;
        scale: number;
      }

      interface HeroSplash {
        x: number;
        y: number;
        r: number;
        isRed: boolean;
        lobes: number[];
      }

      interface Star {
        x: number;
        y: number;
        r: number;
        phase: number;
      }

      let particles: SeasonalParticle[] = [];
      let birds: Bird[] = [];
      const heroSplashes: HeroSplash[] = [];
      const stars: Star[] = Array.from({ length: 20 }, () => ({
        x: 0.08 + Math.random() * 0.84,
        y: 0.07 + Math.random() * 0.42,
        r: 0.8 + Math.random() * 1.2,
        phase: Math.random() * Math.PI * 2,
      }));

      function emitStatus() {
        const el = document.getElementById('wuji-sky-label');
        if (el) el.textContent = snapshot.label;
        const navBtn = document.getElementById('nav-sky-btn');
        if (navBtn) {
          const pName = PRESETS[presetIdx].name;
          navBtn.textContent = pName === '实时' ? '四时' : pName;
          navBtn.title = snapshot.label;
        }
        window.dispatchEvent(
          new CustomEvent('wuji-sky-update', {
            detail: { label: snapshot.label, presetName: PRESETS[presetIdx].name },
          })
        );
      }

      function initSeasonalEntities() {
        renderSeasonBranch(snapshot.season);
        const count = snapshot.season === 'summer' && snapshot.isDay ? 26 : 18;
        particles = Array.from({ length: count }, (_, i) => {
          if (snapshot.season === 'winter') {
            return {
              x: Math.random() * w,
              y: Math.random() * h,
              vx: -0.18 - Math.random() * 0.25,
              vy: 0.35 + Math.random() * 0.55,
              size: 1.6 + Math.random() * 2.6,
              rot: Math.random() * Math.PI * 2,
              vrot: (Math.random() - 0.5) * 0.018,
              phase: Math.random() * Math.PI * 2,
              alpha: 0.26 + Math.random() * 0.38,
              tint: i % 6 === 0 ? 1 : 0, // occasional plum petal among snow
            };
          }
          if (snapshot.season === 'spring') {
            return {
              x: Math.random() * w,
              y: Math.random() * h,
              vx: -0.35 - Math.random() * 0.4,
              vy: 0.28 + Math.random() * 0.36,
              size: 3.2 + Math.random() * 3.2,
              rot: Math.random() * Math.PI * 2,
              vrot: (Math.random() - 0.5) * 0.03,
              phase: Math.random() * Math.PI * 2,
              alpha: 0.24 + Math.random() * 0.3,
              tint: i % 3 === 0 ? 1 : 0,
            };
          }
          if (snapshot.season === 'summer') {
            if (snapshot.isDay) {
              // 江南细雨丝
              return {
                x: Math.random() * w,
                y: Math.random() * h,
                vx: -0.9,
                vy: 4.5 + Math.random() * 2.5,
                size: 12 + Math.random() * 14,
                rot: 0,
                vrot: 0,
                phase: Math.random() * Math.PI * 2,
                alpha: 0.12 + Math.random() * 0.14,
                tint: 0,
              };
            }
            // 夏夜流萤
            return {
              x: Math.random() * w,
              y: h * (0.42 + Math.random() * 0.46),
              vx: (Math.random() - 0.5) * 0.35,
              vy: (Math.random() - 0.5) * 0.22,
              size: 1.6 + Math.random() * 2,
              rot: 0,
              vrot: 0,
              phase: Math.random() * Math.PI * 2,
              alpha: 0.35 + Math.random() * 0.45,
              tint: 0,
            };
          }
          // 秋：疏林霜枫
          return {
            x: Math.random() * w,
            y: Math.random() * h,
            vx: -0.38 - Math.random() * 0.38,
            vy: 0.42 + Math.random() * 0.45,
            size: 4.5 + Math.random() * 4,
            rot: Math.random() * Math.PI * 2,
            vrot: (Math.random() - 0.5) * 0.035,
            phase: Math.random() * Math.PI * 2,
            alpha: 0.25 + Math.random() * 0.32,
            tint: i % 2,
          };
        });

        // Distant gliding swallows (Spring) or wild geese formation (Autumn)
        if (snapshot.season === 'spring') {
          birds = [
            { x: w * 0.28, y: h * 0.28, vx: 0.42, wingPhase: 0, scale: 1 },
            { x: w * 0.23, y: h * 0.32, vx: 0.4, wingPhase: 1.8, scale: 0.8 },
          ];
        } else if (snapshot.season === 'autumn') {
          birds = [
            { x: w * 0.72, y: h * 0.22, vx: -0.34, wingPhase: 0, scale: 0.95 },
            { x: w * 0.75, y: h * 0.245, vx: -0.34, wingPhase: 0.9, scale: 0.82 },
            { x: w * 0.78, y: h * 0.27, vx: -0.34, wingPhase: 1.7, scale: 0.72 },
            { x: w * 0.745, y: h * 0.205, vx: -0.34, wingPhase: 2.3, scale: 0.76 },
          ];
        } else {
          birds = [];
        }
      }

      function resize() {
        w = Math.max(320, window.innerWidth);
        h = Math.max(420, window.innerHeight);
        canvas!.width = w;
        canvas!.height = h;
        initSeasonalEntities();
      }

      // Compute Sun/Moon coordinates along celestial arc based on exact hour
      function getCelestialCoords(snap: SkySnapshot): { x: number; y: number; progress: number } {
        let progress = 0.5;
        if (snap.isDay) {
          // 05:30 -> 18:30 (13 hours)
          progress = Math.max(0, Math.min(1, (snap.hourFloat - 5.5) / 13));
        } else {
          // 18:30 -> 05:30 next day (11 hours)
          const nightHours = snap.hourFloat >= 18.5 ? snap.hourFloat - 18.5 : snap.hourFloat + 5.5;
          progress = Math.max(0, Math.min(1, nightHours / 11));
        }
        // Keep arc gracefully framed on the right/upper sky so it never clashes with left title
        const x = w * (0.38 + progress * 0.5);
        const arc = Math.sin(progress * Math.PI);
        const y = h * (0.56 - arc * 0.39);
        return { x, y, progress };
      }

      function drawSunOrMoon(tSec: number) {
        const isDark = document.documentElement.classList.contains('dark');
        const { x, y, progress } = getCelestialCoords(snapshot);

        // Subtle dotted celestial orbit arc
        ctx!.save();
        ctx!.strokeStyle = isDark ? 'rgba(231, 226, 215, 0.06)' : 'rgba(28, 27, 24, 0.055)';
        ctx!.lineWidth = 1;
        ctx!.setLineDash([2, 8]);
        ctx!.beginPath();
        ctx!.moveTo(w * 0.36, h * 0.58);
        ctx!.quadraticCurveTo(w * 0.63, h * 0.04, w * 0.9, h * 0.58);
        ctx!.stroke();
        ctx!.restore();

        if (snapshot.isDay) {
          // Daytime Sun (素日 / 朝霞 / 晚照)
          const isLow = progress < 0.22 || progress > 0.78;
          const haloColor = isLow
            ? isDark
              ? 'rgba(196, 86, 68, 0.16)'
              : 'rgba(158, 52, 38, 0.13)'
            : isDark
              ? 'rgba(218, 188, 142, 0.12)'
              : 'rgba(158, 42, 34, 0.085)';

          const sunR = Math.min(w, h) * 0.042;
          const halo = ctx!.createRadialGradient(x, y, sunR * 0.2, x, y, sunR * 3.8);
          halo.addColorStop(0, haloColor);
          halo.addColorStop(1, 'rgba(0,0,0,0)');
          ctx!.fillStyle = halo;
          ctx!.beginPath();
          ctx!.arc(x, y, sunR * 3.8, 0, Math.PI * 2);
          ctx!.fill();

          // Quiet ink-wash sun disc
          ctx!.fillStyle = isLow
            ? isDark
              ? 'rgba(208, 92, 74, 0.42)'
              : 'rgba(158, 42, 34, 0.24)'
            : isDark
              ? 'rgba(232, 214, 184, 0.34)'
              : 'rgba(158, 42, 34, 0.16)';
          ctx!.beginPath();
          ctx!.arc(x, y, sunR, 0, Math.PI * 2);
          ctx!.fill();

          ctx!.strokeStyle = isDark ? 'rgba(232, 214, 184, 0.28)' : 'rgba(158, 42, 34, 0.22)';
          ctx!.lineWidth = 1;
          ctx!.stroke();
        } else {
          // Nighttime: Sparse breathing stars + Accurate Lunar Phase Moon
          for (const st of stars) {
            const twinkle = 0.22 + 0.35 * (0.5 + 0.5 * Math.sin(tSec * 1.1 + st.phase));
            ctx!.fillStyle = isDark
              ? `rgba(231, 226, 215, ${twinkle})`
              : `rgba(28, 27, 24, ${twinkle * 0.45})`;
            ctx!.beginPath();
            ctx!.arc(st.x * w, st.y * h, st.r, 0, Math.PI * 2);
            ctx!.fill();
          }

          const moonR = Math.min(w, h) * 0.038;
          // Soft lunar halo
          const halo = ctx!.createRadialGradient(x, y, moonR * 0.3, x, y, moonR * 4.2);
          halo.addColorStop(0, isDark ? 'rgba(231, 226, 215, 0.16)' : 'rgba(70, 93, 94, 0.11)');
          halo.addColorStop(1, 'rgba(0,0,0,0)');
          ctx!.fillStyle = halo;
          ctx!.beginPath();
          ctx!.arc(x, y, moonR * 4.2, 0, Math.PI * 2);
          ctx!.fill();

          // Accurate lunar phase rendering
          ctx!.save();
          ctx!.translate(x, y);
          // Subtle unlit disc rim
          ctx!.strokeStyle = isDark ? 'rgba(231, 226, 215, 0.2)' : 'rgba(28, 27, 24, 0.15)';
          ctx!.lineWidth = 0.9;
          ctx!.beginPath();
          ctx!.arc(0, 0, moonR, 0, Math.PI * 2);
          ctx!.stroke();

          // Illuminated crescent / gibbous shape
          const p = snapshot.moonPhase; // 0 new, 0.5 full, 1 new
          const litColor = isDark ? 'rgba(238, 232, 218, 0.72)' : 'rgba(28, 27, 24, 0.2)';
          const bgColor = isDark ? '#121210' : '#f6f3ec';

          ctx!.beginPath();
          ctx!.arc(0, 0, moonR, 0, Math.PI * 2);
          ctx!.clip();

          // Fill illuminated half
          ctx!.fillStyle = litColor;
          ctx!.beginPath();
          if (p <= 0.5) {
            ctx!.arc(0, 0, moonR, -Math.PI / 2, Math.PI / 2, false);
          } else {
            ctx!.arc(0, 0, moonR, Math.PI / 2, -Math.PI / 2, false);
          }
          ctx!.fill();

          // Terminator ellipse
          const cosPhase = Math.cos(p * Math.PI * 2); // 1 at new, -1 at full
          const termRx = Math.abs(cosPhase) * moonR;
          ctx!.beginPath();
          ctx!.ellipse(0, 0, termRx, moonR, 0, 0, Math.PI * 2);
          ctx!.fillStyle = cosPhase > 0 ? bgColor : litColor;
          ctx!.fill();

          ctx!.restore();
        }
      }

      function drawSeasonalMotifs(tSec: number) {
        const isDark = document.documentElement.classList.contains('dark');

        // Persistent user hero splashes (泼墨)
        for (const sp of heroSplashes) {
          const rgb = sp.isRed
            ? isDark
              ? '196, 74, 64'
              : '158, 42, 34'
            : isDark
              ? '226, 221, 210'
              : '28, 27, 24';
          ctx!.fillStyle = `rgba(${rgb}, 0.075)`;
          ctx!.beginPath();
          const n = sp.lobes.length;
          for (let i = 0; i <= n; i++) {
            const ang = (i / n) * Math.PI * 2;
            const rr = sp.r * sp.lobes[i % n];
            const px = sp.x + Math.cos(ang) * rr;
            const py = sp.y + Math.sin(ang) * rr;
            if (i === 0) ctx!.moveTo(px, py);
            else ctx!.lineTo(px, py);
          }
          ctx!.closePath();
          ctx!.fill();
        }

        // Gliding swallows (Spring) or geese (Autumn)
        if (birds.length > 0) {
          ctx!.strokeStyle = isDark ? 'rgba(231, 226, 215, 0.28)' : 'rgba(28, 27, 24, 0.25)';
          ctx!.lineWidth = 1.25;
          ctx!.lineCap = 'round';
          for (const b of birds) {
            b.x += b.vx;
            b.wingPhase += 0.055;
            if (b.x > w + 40) b.x = -30;
            if (b.x < -40) b.x = w + 30;
            const flap = Math.sin(b.wingPhase) * 3.8 * b.scale;
            const span = 8.5 * b.scale;
            ctx!.beginPath();
            ctx!.moveTo(b.x - span, b.y + flap);
            ctx!.quadraticCurveTo(b.x - span * 0.4, b.y - 3 * b.scale, b.x, b.y);
            ctx!.quadraticCurveTo(b.x + span * 0.4, b.y - 3 * b.scale, b.x + span, b.y + flap);
            ctx!.stroke();
          }
        }

        // Seasonal particles
        for (const p of particles) {
          if (snapshot.season === 'winter') {
            p.x += p.vx + Math.sin(tSec * 0.9 + p.phase) * 0.25;
            p.y += p.vy;
            if (p.y > h + 10) { p.y = -8; p.x = Math.random() * w; }
            if (p.x < -10) p.x = w + 8;

            if (p.tint === 1) {
              // Tiny cinnabar plum petal
              ctx!.save();
              ctx!.translate(p.x, p.y);
              ctx!.rotate(p.rot + tSec * 0.6);
              ctx!.fillStyle = isDark
                ? `rgba(196, 74, 64, ${p.alpha * 0.85})`
                : `rgba(158, 42, 34, ${p.alpha * 0.72})`;
              ctx!.beginPath();
              ctx!.ellipse(0, 0, p.size * 1.15, p.size * 0.65, 0, 0, Math.PI * 2);
              ctx!.fill();
              ctx!.restore();
            } else {
              // Delicate ink-silver snowflake
              ctx!.fillStyle = isDark
                ? `rgba(235, 232, 224, ${p.alpha})`
                : `rgba(70, 93, 94, ${p.alpha * 0.55})`;
              ctx!.beginPath();
              ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2);
              ctx!.fill();
            }
          } else if (snapshot.season === 'spring') {
            p.x += p.vx + Math.sin(tSec * 1.1 + p.phase) * 0.3;
            p.y += p.vy;
            p.rot += p.vrot;
            if (p.y > h + 12) { p.y = -10; p.x = Math.random() * w; }
            if (p.x < -12) p.x = w + 10;

            ctx!.save();
            ctx!.translate(p.x, p.y);
            ctx!.rotate(p.rot);
            ctx!.fillStyle =
              p.tint === 1
                ? isDark
                  ? `rgba(206, 114, 108, ${p.alpha})`
                  : `rgba(176, 86, 80, ${p.alpha * 0.85})`
                : isDark
                  ? `rgba(225, 220, 210, ${p.alpha * 0.7})`
                  : `rgba(70, 93, 94, ${p.alpha * 0.65})`;
            ctx!.beginPath();
            ctx!.ellipse(0, 0, p.size, p.size * 0.45, 0, 0, Math.PI * 2);
            ctx!.fill();
            ctx!.restore();
          } else if (snapshot.season === 'summer') {
            if (snapshot.isDay) {
              // 江南细雨丝
              p.x += p.vx;
              p.y += p.vy;
              if (p.y > h + 20) { p.y = -20; p.x = Math.random() * (w + 60); }
              ctx!.strokeStyle = isDark
                ? `rgba(175, 198, 196, ${p.alpha})`
                : `rgba(70, 93, 94, ${p.alpha * 1.1})`;
              ctx!.lineWidth = 0.85;
              ctx!.beginPath();
              ctx!.moveTo(p.x, p.y);
              ctx!.lineTo(p.x - 2.6, p.y + p.size);
              ctx!.stroke();
            } else {
              // 夏夜流萤
              p.x += p.vx + Math.sin(tSec * 0.8 + p.phase) * 0.25;
              p.y += p.vy + Math.cos(tSec * 0.7 + p.phase) * 0.18;
              if (p.x < 0) p.x = w;
              if (p.x > w) p.x = 0;
              if (p.y < h * 0.36) p.y = h * 0.86;
              if (p.y > h * 0.9) p.y = h * 0.4;
              const pulse = 0.25 + 0.75 * (0.5 + 0.5 * Math.sin(tSec * 2.1 + p.phase));
              ctx!.fillStyle = `rgba(196, 168, 96, ${p.alpha * pulse})`;
              ctx!.beginPath();
              ctx!.arc(p.x, p.y, p.size * 2.4, 0, Math.PI * 2);
              ctx!.fill();
              ctx!.fillStyle = `rgba(242, 224, 158, ${p.alpha * pulse})`;
              ctx!.beginPath();
              ctx!.arc(p.x, p.y, p.size * 0.85, 0, Math.PI * 2);
              ctx!.fill();
            }
          } else {
            // 秋：霜枫红叶 / 银杏叶
            p.x += p.vx + Math.sin(tSec * 1.2 + p.phase) * 0.35;
            p.y += p.vy;
            p.rot += p.vrot;
            if (p.y > h + 15) { p.y = -12; p.x = Math.random() * (w + 60); }
            if (p.x < -15) p.x = w + 12;

            ctx!.save();
            ctx!.translate(p.x, p.y);
            ctx!.rotate(p.rot);
            ctx!.fillStyle =
              p.tint === 0
                ? isDark
                  ? `rgba(196, 82, 68, ${p.alpha})`
                  : `rgba(158, 52, 38, ${p.alpha * 0.88})`
                : isDark
                  ? `rgba(194, 158, 96, ${p.alpha * 0.9})`
                  : `rgba(138, 106, 54, ${p.alpha * 0.78})`;
            // Stylized ink leaf
            ctx!.beginPath();
            ctx!.moveTo(0, -p.size);
            ctx!.quadraticCurveTo(p.size * 0.85, -p.size * 0.15, 0, p.size);
            ctx!.quadraticCurveTo(-p.size * 0.85, -p.size * 0.15, 0, -p.size);
            ctx!.fill();
            ctx!.restore();
          }
        }
      }

      function loop(now: number) {
        if (!inView || !tabVisible) {
          rafId = 0;
          return;
        }
        // Gentle 30fps cap for calm poetic motion & ultra-low battery/CPU usage
        if (now - lastFrame >= 32) {
          lastFrame = now;
          ctx!.clearRect(0, 0, w, h);
          const tSec = now * 0.001;
          drawSunOrMoon(tSec);
          drawSeasonalMotifs(tSec);
        }
        rafId = requestAnimationFrame(loop);
      }

      function startIfVisible() {
        if (inView && tabVisible && !rafId) {
          rafId = requestAnimationFrame(loop);
        }
      }

      // Keep running smoothly across all pages; pause only when tab is hidden
      document.addEventListener('visibilitychange', () => {
        tabVisible = !document.hidden;
        startIfVisible();
      });

      // Refresh live clock every 60s when in real-time mode
      setInterval(() => {
        if (presetIdx === 0) {
          snapshot = PRESETS[0].build();
          emitStatus();
        }
      }, 60000);

      // Cycle season/time preview via "观四时" (persisted across page navigations)
      window.addEventListener('wuji-cycle-sky', () => {
        presetIdx = (presetIdx + 1) % PRESETS.length;
        sessionStorage.setItem('wuji-sky-preset', String(presetIdx));
        snapshot = PRESETS[presetIdx].build();
        initSeasonalEntities();
        emitStatus();
      });

      window.addEventListener('wuji-hero-splash', ((e: CustomEvent) => {
        heroSplashes.push({
          x: w * (0.2 + Math.random() * 0.62),
          y: h * (0.22 + Math.random() * 0.5),
          r: 36 + Math.random() * 64,
          isRed: Boolean(e.detail?.isRed),
          lobes: Array.from({ length: 10 }, () => 0.74 + Math.random() * 0.42),
        });
        if (heroSplashes.length > 10) heroSplashes.shift();
      }) as EventListener);

      window.addEventListener('wuji-hero-clear', () => {
        heroSplashes.length = 0;
      });

      resize();
      emitStatus();
      startIfVisible();
      window.addEventListener('resize', resize, { passive: true });
    }
  }

  // Smooth auto-sleeping parallax for mountain layers
  if (layers.length > 0 && window.matchMedia('(pointer: fine)').matches) {
    let tx = 0;
    let ty = 0;
    let cx = 0;
    let cy = 0;
    let pRunning = false;

    function tickParallax() {
      cx += (tx - cx) * 0.075;
      cy += (ty - cy) * 0.075;
      for (const layer of layers) {
        const depth = Number(layer.dataset.parallax || 16);
        layer.style.transform = `translate3d(${(-cx * depth).toFixed(2)}px, ${(-cy * depth * 0.45).toFixed(2)}px, 0)`;
      }
      if (Math.abs(tx - cx) > 0.0008 || Math.abs(ty - cy) > 0.0008) {
        requestAnimationFrame(tickParallax);
      } else {
        pRunning = false;
      }
    }

    window.addEventListener(
      'pointermove',
      (e) => {
        tx = e.clientX / Math.max(window.innerWidth, 1) - 0.5;
        ty = e.clientY / Math.max(window.innerHeight, 1) - 0.5;
        if (!pRunning) {
          pRunning = true;
          requestAnimationFrame(tickParallax);
        }
      },
      { passive: true }
    );
  }
</script>
