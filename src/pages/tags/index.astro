---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagsMap } from '../../utils/blog';

const posts = await getPublishedPosts();
const tags = getTagsMap(posts);
---

<BaseLayout title="标签索引" description="通过标签探索无极 (WuJi) 的全部技术笔记与文章主题。">
  <section class="max-w-4xl mx-auto px-5 sm:px-8 pt-8 pb-20">
    <header class="pb-8 border-b border-[var(--border-strong)] mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] font-editorial tracking-wide">
        标签索引
      </h1>
      <p class="mt-3 text-sm text-[var(--text-secondary)]">
        共 <span class="font-mono text-[var(--text-primary)]">{tags.length}</span> 个关键词标签。
      </p>
    </header>

    <div class="flex flex-wrap gap-x-6 gap-y-4">
      {
        tags.map((tag) => (
          <a
            href={`/tags/${encodeURIComponent(tag.name)}/`}
            class="group inline-flex items-baseline gap-1.5 py-1 border-b border-transparent hover:border-[var(--accent-seal)] transition-colors"
          >
            <span class="text-[15px] font-editorial text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] transition-colors">
              #{tag.name}
            </span>
            <sup class="text-[11px] font-mono text-[var(--text-muted)]">{tag.count}</sup>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
