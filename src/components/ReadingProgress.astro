---
/**
 * Top reading progress bar + Floating Back-to-Top button
 */
---

<div
  id="wuji-reading-progress"
  class="fixed top-0 left-0 h-[2.5px] z-50 w-0 pointer-events-none transition-[width] duration-75"
  style="background: linear-gradient(90deg, #e5b567 0%, #f5d896 50%, #38d9c0 100%); box-shadow: 0 0 12px rgba(229, 181, 103, 0.65);"
  aria-hidden="true"
></div>

<button
  id="wuji-back-top"
  type="button"
  aria-label="返回顶部"
  title="返回顶部"
  class="fixed bottom-6 right-6 z-40 hidden items-center justify-center w-11 h-11 rounded-2xl wuji-glass border border-[var(--border-strong)] text-[var(--accent-gold)] shadow-xl hover:-translate-y-1 hover:border-[var(--accent-gold)]/60 transition-all cursor-pointer"
>
  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
    <path d="m18 15-6-6-6 6" />
  </svg>
</button>

<script>
  const bar = document.getElementById('wuji-reading-progress');
  const backTop = document.getElementById('wuji-back-top');

  function onScroll() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
    if (bar) bar.style.width = `${pct}%`;

    if (backTop) {
      if (scrollTop > 420) {
        backTop.classList.remove('hidden');
        backTop.classList.add('flex');
      } else {
        backTop.classList.add('hidden');
        backTop.classList.remove('flex');
      }
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  backTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
