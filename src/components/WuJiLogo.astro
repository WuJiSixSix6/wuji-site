  <path
    d="M32 13C42.493 13 51 21.507 51 32C51 42.493 42.493 51 32 51C26.753 51 22.5 46.747 22.5 41.5C22.5 36.253 26.753 32 32 32C37.247 32 41.5 27.747 41.5 22.5C41.5 17.253 37.247 13 32 13Z"
