---
/**
 * Cinnabar-Ink brush reading progress bar + Floating Inkstone Back-to-Top button
 */
---

<div
  id="wuji-reading-progress"
  class="fixed top-0 left-0 h-[3px] z-50 w-0 pointer-events-none transition-[width] duration-75"
  style="background: linear-gradient(90deg, #181c1f 0%, #2b6469 48%, #b92b27 100%); box-shadow: 0 0 10px rgba(185, 43, 39, 0.55);"
  aria-hidden="true"
></div>

<button
  id="wuji-back-top"
  type="button"
  aria-label="返回顶部"
  title="归顶"
  class="ink-magnetic fixed bottom-6 right-6 z-40 hidden flex-col items-center justify-center w-12 h-12 rounded-2xl wuji-glass border border-[var(--border-strong)] text-[var(--accent-seal)] shadow-xl hover:border-[var(--accent-seal)] transition-all cursor-pointer"
>
  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
    <path d="m18 15-6-6-6 6" />
  </svg>
  <span class="text-[10px] font-calligraphy leading-none mt-0.5">归顶</span>
</button>

<script>
  const bar = document.getElementById('wuji-reading-progress');
  const backTop = document.getElementById('wuji-back-top');

  function onScroll() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
    if (bar) bar.style.width = `${pct}%`;

    if (backTop) {
      if (scrollTop > 400) {
        backTop.classList.remove('hidden');
        backTop.classList.add('flex');
      } else {
        backTop.classList.add('hidden');
        backTop.classList.remove('flex');
      }
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  backTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
