---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryMeta } from '../../data/site';
import { getPublishedPosts, getCategoriesMap, formatDate } from '../../utils/blog';

const posts = await getPublishedPosts();
const categories = getCategoriesMap(posts);
---

<BaseLayout title="文章分类" description="按专题分类浏览无极 (WuJi) 的全部博客内容。">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-20">
    <div class="max-w-2xl mb-12">
      <p class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--accent-gold)]">
        Categories · 专题分类
      </p>
      <h1
        class="mt-2 text-3xl sm:text-5xl font-bold text-[var(--text-primary)]"
        style="font-family: var(--font-serif);"
      >
        知识体系与维度
      </h1>
      <p class="mt-3 text-sm sm:text-base text-[var(--text-secondary)]">
        共划分 <span class="font-mono text-[var(--accent-gold)]">{categories.length}</span> 个核心专题，覆盖技术工程、算法数学、工具体系与深度思考。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        categories.map((cat) => {
          const meta = getCategoryMeta(cat.name);
          const latest = cat.posts[0];
          return (
            <div class="wuji-card wuji-card-interactive p-6 sm:p-7 flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-2xl bg-[var(--bg-elevated)] border border-[var(--border-hairline)] flex items-center justify-center text-xl text-[var(--accent-gold)]">
                      {meta.glyph}
                    </div>
                    <div>
                      <h2
                        class="text-xl font-bold text-[var(--text-primary)]"
                        style="font-family: var(--font-serif);"
                      >
                        <a
                          href={`/categories/${encodeURIComponent(cat.name)}`}
                          class="hover:text-[var(--accent-gold)] transition-colors"
                        >
                          {cat.name}
                        </a>
                      </h2>
                      <p class="text-[11px] font-mono uppercase tracking-[0.18em] text-[var(--text-muted)]">
                        {meta.en}
                      </p>
                    </div>
                  </div>
                  <span class="px-3 py-1 rounded-full text-xs font-mono bg-[var(--accent-gold-soft)] text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
                    {cat.count} 篇
                  </span>
                </div>

                <p class="mt-4 text-sm text-[var(--text-secondary)] leading-relaxed">
                  {meta.desc}
                </p>

                <!-- Preview list -->
                <div class="mt-5 pt-4 border-t border-[var(--border-hairline)] space-y-2.5">
                  {cat.posts.slice(0, 3).map((post) => (
                    <a
                      href={`/blog/${post.id}`}
                      class="group/item flex items-center justify-between gap-3 text-sm"
                    >
                      <span class="text-[var(--text-primary)] group-hover/item:text-[var(--accent-gold)] transition-colors line-clamp-1">
                        · {post.data.title}
                      </span>
                      <span class="shrink-0 text-[11px] font-mono text-[var(--text-muted)]">
                        {formatDate(post.data.pubDate)}
                      </span>
                    </a>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-[var(--border-hairline)] flex items-center justify-between">
                <span class="text-xs text-[var(--text-muted)]">
                  最近更新：{latest ? formatDate(latest.data.pubDate) : '-'}
                </span>
                <a
                  href={`/categories/${encodeURIComponent(cat.name)}`}
                  class="text-xs font-medium text-[var(--accent-gold)] hover:underline"
                >
                  进入该专题 →
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
