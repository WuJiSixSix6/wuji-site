---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, getCategoryMeta } from '../data/site';
import {
  getPublishedPosts,
  getCategoriesMap,
  getTotalStats,
  computePostMeta,
  formatDate,
} from '../utils/blog';

const posts = await getPublishedPosts();
const stats = getTotalStats(posts);
const categories = getCategoriesMap(posts);

const leadPost = posts.find((p) => p.data.pinned) || posts[0];
const gridPosts = posts.filter((p) => p.id !== leadPost?.id).slice(0, 4);
---

<BaseLayout title={SITE.title} description={SITE.heroSubtitle}>
  <!-- =========================================================
       EXHIBITION-GRADE CHINESE INK WASH HERO (留白 · 画卷)
       ========================================================= -->
  <section class="relative -mt-24 pt-36 pb-16 sm:pt-44 sm:pb-20 overflow-hidden">
    <div class="relative z-10 max-w-5xl mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_180px] gap-12 items-start">
        <!-- Left: Quiet Authoritative Editorial Typography -->
        <div class="max-w-2xl">
          <div class="flex items-center gap-4">
            <h1 class="text-5xl sm:text-7xl font-bold tracking-[0.14em] text-[var(--text-primary)] font-editorial leading-none">
              无极
            </h1>
            <span class="wuji-seal w-8 h-8 sm:w-9 sm:h-9 text-sm sm:text-base mt-1">
              无极
            </span>
          </div>

          <p class="mt-5 text-sm font-mono tracking-[0.26em] uppercase text-[var(--text-muted)]">
            WUJI · PERSONAL ARCHIVE &amp; WRITINGS
          </p>

          <p class="mt-7 text-base sm:text-[17px] text-[var(--text-secondary)] leading-[1.95] max-w-xl font-editorial">
            {SITE.tagline} {SITE.heroSubtitle}
          </p>

          <!-- Clean Editorial Links (No flashy SaaS gradient buttons) -->
          <div class="mt-9 flex flex-wrap items-center gap-6 text-sm">
            <a
              href="/blog/"
              class="ink-magnetic inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--ink-primary)] text-[var(--bg-canvas)] rounded-[3px] tracking-[0.1em] hover:opacity-88 transition-opacity"
            >
              <span>进入文集</span>
              <span aria-hidden="true">→</span>
            </a>

            <a
              href="/archive/"
              class="text-[var(--text-secondary)] hover:text-[var(--accent-seal)] pb-0.5 border-b border-[var(--border-strong)] hover:border-[var(--accent-seal)] transition-colors tracking-[0.08em]"
            >
              按年归档
            </a>

            <a
              href="/about/"
              class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors tracking-[0.08em]"
            >
              关于站主
            </a>
          </div>
        </div>

        <!-- Right: Classical Vertical Inscription (立轴题跋 · 点击可换句) -->
        <div class="hidden lg:flex justify-end pt-2">
          <button
            id="wuji-motto-btn"
            type="button"
            title="轻点切换立轴题句"
            class="group flex items-start gap-4 py-4 px-5 border-l border-[var(--border-hairline)] text-left cursor-pointer focus:outline-none"
          >
            <span
              id="wuji-motto-text"
              class="vertical-inscription text-[15px] text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] font-calligraphy leading-relaxed transition-opacity duration-300 h-52"
            >
              道生一，一生二，二生三，三生万物。
            </span>
            <div class="flex flex-col items-center gap-3 pt-1">
              <span class="wuji-seal-outline w-5 py-1.5 text-[10px] vertical-inscription tracking-normal">
                诗笺
              </span>
              <span class="text-[10px] text-[var(--text-muted)] group-hover:text-[var(--accent-seal)] vertical-inscription tracking-widest">
                轻点换句
              </span>
            </div>
          </button>
        </div>
      </div>

      <!-- Quiet Bottom Colophon Rule + Live Astronomical Status & Minimal Ink Actions -->
      <div class="mt-20 pt-5 border-t border-[var(--border-hairline)] flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
        <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1">
          <span id="wuji-sky-label" class="font-editorial text-[var(--text-secondary)]">
            四时天轨演算中…
          </span>
          <span class="opacity-40">·</span>
          <span class="font-mono">藏文 {stats.postCount} 篇 / {(stats.totalWords / 1000).toFixed(1)} 千字</span>
        </div>

        <div class="flex items-center gap-5">
          <button
            id="hero-btn-sky"
            type="button"
            class="text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors cursor-pointer"
            title="切换预览春晨、夏夜、秋暮、冬望与实时天时"
          >
            观四时
          </button>
          <span class="h-3 w-[1px] bg-[var(--border-hairline)]" aria-hidden="true"></span>
          <button
            id="hero-btn-splash"
            type="button"
            class="hover:text-[var(--text-primary)] transition-colors cursor-pointer"
          >
            泼墨
          </button>
          <button
            id="hero-btn-stamp"
            type="button"
            class="hover:text-[var(--accent-seal)] transition-colors cursor-pointer"
          >
            落印
          </button>
          <button
            id="hero-btn-clear"
            type="button"
            class="hover:text-[var(--text-primary)] transition-colors cursor-pointer"
          >
            拂尘
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       LEAD ESSAY SPREAD (卷首长文)
       ========================================================= -->
  {
    leadPost && (() => {
      const meta = computePostMeta(leadPost.body);
      return (
        <section class="max-w-5xl mx-auto px-5 sm:px-8 py-12">
          <div class="flex items-baseline justify-between mb-6 ink-reveal">
            <h2 class="text-sm font-editorial tracking-[0.2em] text-[var(--text-muted)]">
              卷首精选
            </h2>
            <a
              href="/blog/"
              class="text-xs text-[var(--text-muted)] hover:text-[var(--accent-seal)] transition-colors"
            >
              全部文章 →
            </a>
          </div>

          <a
            href={`/blog/${leadPost.id}/`}
            class="wuji-card wuji-card-interactive ink-reveal group block p-7 sm:p-10 border-l-2 border-l-[var(--accent-seal)]"
          >
            <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--text-muted)] mb-4">
              <span class="wuji-seal px-1.5 py-0.5 text-[10px]">卷首</span>
              <span class="text-[var(--text-secondary)]">「{leadPost.data.category}」</span>
              <span class="font-mono">{formatDate(leadPost.data.pubDate).replace(/-/g, '.')}</span>
              <span>·</span>
              <span class="font-mono">{meta.readingMinutes} 分钟阅读</span>
              <span>·</span>
              <span class="font-mono">{meta.wordCount.toLocaleString()} 字</span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] transition-colors leading-snug font-editorial">
              {leadPost.data.title}
            </h3>

            {leadPost.data.subtitle && (
              <p class="mt-2.5 text-sm sm:text-base text-[var(--text-muted)] font-editorial">
                {leadPost.data.subtitle}
              </p>
            )}

            <p class="mt-4 text-[15px] text-[var(--text-secondary)] leading-[1.9] max-w-3xl">
              {leadPost.data.summary}
            </p>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-5 border-t border-[var(--border-hairline)] text-xs">
              <div class="flex flex-wrap items-center gap-3 font-mono text-[var(--text-muted)]">
                {leadPost.data.tags.slice(0, 4).map((t) => <span>#{t}</span>)}
              </div>
              <span class="text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] tracking-wider transition-colors">
                展卷细读 →
              </span>
            </div>
          </a>
        </section>
      );
    })()
  }

  <!-- =========================================================
       RECENT ESSAYS (近作录 · 2-Column Editorial Book Plates)
       ========================================================= -->
  <section class="max-w-5xl mx-auto px-5 sm:px-8 py-10">
    <div class="flex items-baseline justify-between mb-6 ink-reveal">
      <h2 class="text-sm font-editorial tracking-[0.2em] text-[var(--text-muted)]">
        近期文字
      </h2>
      <a
        href="/archive/"
        class="text-xs text-[var(--text-muted)] hover:text-[var(--accent-seal)] transition-colors"
      >
        时间轴归档 →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {gridPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- =========================================================
       CLASSICAL BOOK CATALOG: CATEGORIES (卷目索引)
       ========================================================= -->
  <section class="max-w-5xl mx-auto px-5 sm:px-8 py-14">
    <div class="flex items-baseline justify-between mb-6 ink-reveal">
      <h2 class="text-sm font-editorial tracking-[0.2em] text-[var(--text-muted)]">
        卷目索引
      </h2>
      <a
        href="/categories/"
        class="text-xs text-[var(--text-muted)] hover:text-[var(--accent-seal)] transition-colors"
      >
        查看全部分类 →
      </a>
    </div>

    <div class="border-t border-[var(--border-strong)] ink-reveal">
      {
        categories.map((cat, idx) => {
          const meta = getCategoryMeta(cat.name);
          const num = String(idx + 1).padStart(2, '0');
          return (
            <a
              href={`/categories/${encodeURIComponent(cat.name)}/`}
              class="group flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 py-5 border-b border-[var(--border-hairline)] hover:pl-2 transition-all"
            >
              <div class="flex items-baseline gap-4 min-w-0">
                <span class="font-mono text-xs text-[var(--text-muted)] shrink-0">{num}</span>
                <span class="text-base sm:text-lg font-bold font-editorial text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] transition-colors shrink-0">
                  {cat.name}
                </span>
                <span class="hidden md:inline text-sm text-[var(--text-muted)] truncate">
                  — {meta.desc}
                </span>
              </div>
              <div class="flex items-center gap-4 pl-8 sm:pl-0 shrink-0 text-xs font-mono text-[var(--text-muted)]">
                <span>{cat.count} 篇</span>
                <span class="group-hover:text-[var(--accent-seal)] transition-colors">→</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<script>
  const mottos = [
    '道生一，一生二，二生三，三生万物。',
    '无极而太极，极简而深邃。',
    '山高月小，水落石出，架构亦然。',
    '静水流深，繁华落尽见真淳。',
    '致虚极，守静笃，万物并作。',
  ];
  let mottoIdx = 0;
  const mottoBtn = document.getElementById('wuji-motto-btn');
  const mottoText = document.getElementById('wuji-motto-text');

  mottoBtn?.addEventListener('click', (e) => {
    mottoIdx = (mottoIdx + 1) % mottos.length;
    if (mottoText) {
      mottoText.style.opacity = '0';
      setTimeout(() => {
        mottoText.textContent = mottos[mottoIdx];
        mottoText.style.opacity = '1';
      }, 180);
    }
    window.dispatchEvent(
      new CustomEvent('wuji-ink-splash', {
        detail: { x: e.clientX, y: e.clientY, isRed: true, big: false },
      })
    );
  });

  const stampWords = ['无极', '清雅', '悟道', '极境', '墨韵'];
  let stampIdx = 0;

  document.getElementById('hero-btn-splash')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('wuji-hero-splash', { detail: { isRed: Math.random() < 0.2 } }));
    window.dispatchEvent(new CustomEvent('wuji-ink-splash', { detail: { isRed: false, big: true } }));
  });

  document.getElementById('hero-btn-stamp')?.addEventListener('click', () => {
    const word = stampWords[stampIdx % stampWords.length];
    stampIdx++;
    window.dispatchEvent(
      new CustomEvent('wuji-stamp-effect', {
        detail: {
          x: window.innerWidth * (0.48 + Math.random() * 0.3),
          y: window.innerHeight * (0.24 + Math.random() * 0.34),
          text: word,
        },
      })
    );
  });

  document.getElementById('hero-btn-clear')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('wuji-hero-clear'));
  });

  // Live Astronomical & Seasonal status sync + "观四时" cycle control
  const skyLabelEl = document.getElementById('wuji-sky-label');
  const skyCycleBtn = document.getElementById('hero-btn-sky');

  window.addEventListener('wuji-sky-update', ((e: CustomEvent) => {
    const label = e.detail?.label;
    const presetName = e.detail?.presetName;
    if (skyLabelEl && label) skyLabelEl.textContent = label;
    if (skyCycleBtn && presetName) {
      skyCycleBtn.textContent = presetName === '实时' ? '观四时' : `观四时（${presetName}）`;
    }
  }) as EventListener);

  skyCycleBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('wuji-cycle-sky'));
  });
</script>
