---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section
  class="my-12 p-6 border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-[3px]"
  data-seal-slug={slug}
  id="wuji-seal-colophon"
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="wuji-seal w-5 h-5 text-[11px]">印</span>
        <span class="text-xs font-editorial tracking-[0.2em] text-[var(--text-primary)]">
          卷尾落印
        </span>
      </div>
      <p class="text-xs text-[var(--text-muted)]">
        若此篇有所启发，不妨择一印章留痕。
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <button
        type="button"
        data-stamp-word="绝妙"
        class="seal-trigger ink-magnetic inline-flex items-center gap-1.5 px-3 py-1.5 rounded-[2px] border border-[var(--accent-seal)]/45 text-xs text-[var(--accent-seal)] hover:bg-[var(--accent-seal)] hover:text-[#f6f1e7] transition-colors cursor-pointer"
      >
        <span class="font-calligraphy text-sm">绝妙</span>
        <span class="font-mono opacity-80" data-count-for="绝妙">0</span>
      </button>
      <button
        type="button"
        data-stamp-word="已阅"
        class="seal-trigger ink-magnetic inline-flex items-center gap-1.5 px-3 py-1.5 rounded-[2px] border border-[var(--border-strong)] text-xs text-[var(--text-primary)] hover:border-[var(--accent-seal)] hover:text-[var(--accent-seal)] transition-colors cursor-pointer"
      >
        <span class="font-calligraphy text-sm">已阅</span>
        <span class="font-mono opacity-75" data-count-for="已阅">0</span>
      </button>
      <button
        type="button"
        data-stamp-word="清雅"
        class="seal-trigger ink-magnetic inline-flex items-center gap-1.5 px-3 py-1.5 rounded-[2px] border border-[var(--border-hairline)] text-xs text-[var(--text-secondary)] hover:border-[var(--accent-jade)] hover:text-[var(--accent-jade)] transition-colors cursor-pointer"
      >
        <span class="font-calligraphy text-sm">清雅</span>
        <span class="font-mono opacity-75" data-count-for="清雅">0</span>
      </button>
    </div>
  </div>

  <div id="wuji-stamped-marks" class="mt-4 pt-4 border-t border-[var(--border-hairline)] hidden flex-wrap items-center gap-2.5">
    <span class="text-xs text-[var(--text-muted)] mr-1">已印：</span>
  </div>
</section>

<script>
  const box = document.getElementById('wuji-seal-colophon');
  const marksWrap = document.getElementById('wuji-stamped-marks');
  if (box) {
    const slug = box.dataset.sealSlug || 'default';
    const key = `wuji-seals-${slug}`;
    const stored: Record<string, number> = JSON.parse(localStorage.getItem(key) || '{}');

    function syncUI() {
      let hasAny = false;
      box!.querySelectorAll<HTMLElement>('[data-count-for]').forEach((el) => {
        const word = el.dataset.countFor || '';
        const count = stored[word] || 0;
        el.textContent = String(count);
        if (count > 0) hasAny = true;
      });

      if (marksWrap && hasAny) {
        marksWrap.classList.remove('hidden');
        marksWrap.classList.add('flex');
        const label = '<span class="text-xs text-[var(--text-muted)] mr-1">已印：</span>';
        const badges = Object.entries(stored)
          .filter(([, c]) => c > 0)
          .map(
            ([w, c]) =>
              `<span class="wuji-seal px-2 py-1 text-xs animate-stamp-pop">${w}${c > 1 ? ` ×${c}` : ''}</span>`
          )
          .join('');
        marksWrap.innerHTML = label + badges;
      }
    }

    syncUI();

    box.querySelectorAll<HTMLButtonElement>('.seal-trigger').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const word = btn.dataset.stampWord || '无极';
        stored[word] = (stored[word] || 0) + 1;
        localStorage.setItem(key, JSON.stringify(stored));
        syncUI();

        const rect = btn.getBoundingClientRect();
        window.dispatchEvent(
          new CustomEvent('wuji-stamp-effect', {
            detail: {
              x: e.clientX || rect.left + rect.width / 2,
              y: e.clientY || rect.top + rect.height / 2,
              text: word,
            },
          })
        );
      });
    });
  }
</script>
