---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCategoryMeta } from '../../data/site';
import { getPublishedPosts, getCategoriesMap } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = getCategoriesMap(posts);
  return categories.map((cat) => ({
    params: { category: cat.name },
    props: {
      categoryName: cat.name,
      posts: cat.posts,
      allCategories: categories,
    },
  }));
}

const { categoryName, posts, allCategories } = Astro.props;
const meta = getCategoryMeta(categoryName);
---

<BaseLayout title={`分类：${categoryName}`} description={meta.desc}>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-20">
    <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-[var(--text-muted)] mb-6">
      <a href="/" class="hover:text-[var(--accent-gold)]">首页</a>
      <span>/</span>
      <a href="/categories" class="hover:text-[var(--accent-gold)]">分类</a>
      <span>/</span>
      <span class="text-[var(--accent-gold)]">{categoryName}</span>
    </div>

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <div>
        <div class="inline-flex items-center gap-2.5 mb-2">
          <span class="text-2xl text-[var(--accent-gold)]">{meta.glyph}</span>
          <span class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-muted)]">
            {meta.en}
          </span>
        </div>
        <h1
          class="text-3xl sm:text-5xl font-bold text-[var(--text-primary)]"
          style="font-family: var(--font-serif);"
        >
          {categoryName}
        </h1>
        <p class="mt-3 text-sm sm:text-base text-[var(--text-secondary)] max-w-2xl">
          {meta.desc}
        </p>
      </div>
      <div class="text-xs font-mono px-4 py-2 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--accent-gold)] self-start md:self-end">
        共 {posts.length} 篇文章
      </div>
    </div>

    <!-- Switch other categories -->
    <div class="flex flex-wrap items-center gap-2 mb-8">
      {
        allCategories.map((c) => {
          const active = c.name === categoryName;
          return (
            <a
              href={`/categories/${encodeURIComponent(c.name)}`}
              class:list={[
                'px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all',
                active
                  ? 'bg-[var(--accent-gold)] text-[#08090c]'
                  : 'bg-[var(--bg-surface)] text-[var(--text-secondary)] border border-[var(--border-hairline)] hover:border-[var(--accent-gold)]/40',
              ]}
            >
              {c.name} ({c.count})
            </a>
          );
        })
      }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
