---
import { NAV_LINKS, SITE } from '../data/site';
import WuJiLogo from './WuJiLogo.astro';

const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header
  id="wuji-navbar"
  class="fixed top-0 inset-x-0 z-40 transition-all duration-300"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-3.5">
    <nav
      aria-label="主导航"
      class="wuji-glass flex items-center justify-between h-14 px-4 sm:px-5 rounded-2xl border border-[var(--border-hairline)] shadow-[0_10px_30px_-15px_rgba(0,0,0,0.45)]"
    >
      <!-- Brand -->
      <a
        href="/"
        class="group flex items-center gap-2.5 focus:outline-none"
        aria-label="无极 WuJi 首页"
      >
        <WuJiLogo
          size={32}
          class="transition-transform duration-500 group-hover:rotate-90"
        />
        <div class="flex items-baseline gap-1.5">
          <span
            class="text-base font-bold tracking-wider text-[var(--text-primary)]"
            style="font-family: var(--font-serif);"
          >
            {SITE.name}
          </span>
          <span
            class="text-[11px] font-medium tracking-[0.22em] uppercase text-[var(--accent-gold)]"
            style="font-family: var(--font-mono);"
          >
            {SITE.enName}
          </span>
        </div>
      </a>

      <!-- Desktop Links -->
      <div class="hidden md:flex items-center gap-1">
        {
          NAV_LINKS.map((link) => {
            const active = isActive(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'relative px-3.5 py-1.5 rounded-xl text-sm font-medium transition-all duration-200',
                  active
                    ? 'text-[var(--accent-gold)] bg-[var(--accent-gold-soft)]'
                    : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-white/[0.04]',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <!-- Search Trigger -->
        <button
          id="open-search-btn"
          type="button"
          class="group flex items-center gap-2 h-9 px-3 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-elevated)]/60 text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--accent-gold)]/40 transition-all cursor-pointer"
          aria-label="搜索文章 (⌘K)"
        >
          <svg class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--accent-gold)] transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <span class="hidden sm:inline">搜索</span>
          <kbd
            class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono rounded bg-black/20 text-[var(--text-muted)] border border-[var(--border-hairline)]"
          >
            ⌘K
          </kbd>
        </button>

        <!-- Theme Toggle -->
        <button
          id="theme-toggle-btn"
          type="button"
          class="flex items-center justify-center w-9 h-9 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-elevated)]/60 text-[var(--text-secondary)] hover:text-[var(--accent-gold)] hover:border-[var(--accent-gold)]/40 transition-all cursor-pointer"
          aria-label="切换明暗主题"
          title="切换主题"
        >
          <!-- Sun (shown in dark mode) -->
          <svg id="icon-sun" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
          <!-- Moon (shown in light mode) -->
          <svg id="icon-moon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden flex items-center justify-center w-9 h-9 rounded-xl border border-[var(--border-hairline)] bg-[var(--bg-elevated)]/60 text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer"
          aria-label="打开菜单"
          aria-expanded="false"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Dropdown -->
    <div
      id="mobile-menu"
      class="hidden md:hidden mt-2 p-2.5 rounded-2xl wuji-glass border border-[var(--border-hairline)] shadow-2xl"
    >
      <div class="grid grid-cols-2 gap-1.5">
        {
          NAV_LINKS.map((link) => {
            const active = isActive(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors',
                  active
                    ? 'text-[var(--accent-gold)] bg-[var(--accent-gold-soft)]'
                    : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-white/[0.04]',
                ]}
              >
                <span>{link.label}</span>
                <span class="text-[10px] font-mono uppercase opacity-60">{link.en}</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</header>

<script>
  const themeBtn = document.getElementById('theme-toggle-btn');
  const iconSun = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function syncThemeIcons() {
    const isLight = document.documentElement.classList.contains('light');
    if (iconSun && iconMoon) {
      iconSun.classList.toggle('hidden', isLight);
      iconMoon.classList.toggle('hidden', !isLight);
    }
  }

  syncThemeIcons();

  themeBtn?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('wuji-theme', isLight ? 'light' : 'dark');
    syncThemeIcons();
    window.dispatchEvent(new CustomEvent('wuji-theme-change', { detail: { theme: isLight ? 'light' : 'dark' } }));
  });

  mobileBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    mobileBtn.setAttribute('aria-expanded', String(!isHidden));
  });
</script>
