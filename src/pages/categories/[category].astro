---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCategoryMeta } from '../../data/site';
import { getPublishedPosts, getCategoriesMap } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = getCategoriesMap(posts);
  return categories.map((cat) => ({
    params: { category: cat.name },
    props: {
      categoryName: cat.name,
      posts: cat.posts,
      allCategories: categories,
    },
  }));
}

const { categoryName, posts, allCategories } = Astro.props;
const meta = getCategoryMeta(categoryName);
---

<BaseLayout title={`分类：${categoryName}`} description={meta.desc}>
  <section class="max-w-5xl mx-auto px-5 sm:px-8 pt-8 pb-20">
    <nav class="flex items-center gap-2 text-xs text-[var(--text-muted)] mb-7">
      <a href="/" class="hover:text-[var(--text-primary)]">首页</a>
      <span>/</span>
      <a href="/categories/" class="hover:text-[var(--text-primary)]">分类</a>
      <span>/</span>
      <span class="text-[var(--text-primary)]">{categoryName}</span>
    </nav>

    <header class="pb-8 border-b border-[var(--border-strong)] mb-8">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] font-editorial">
          「{categoryName}」
        </h1>
        <span class="text-xs font-mono text-[var(--text-muted)]">共 {posts.length} 篇</span>
      </div>
      <p class="mt-3 text-sm text-[var(--text-secondary)] max-w-2xl">{meta.desc}</p>
    </header>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-8 text-sm">
      {
        allCategories.map((c) => {
          const active = c.name === categoryName;
          return (
            <a
              href={`/categories/${encodeURIComponent(c.name)}/`}
              class:list={[
                'pb-1 border-b-2 transition-colors',
                active
                  ? 'border-[var(--accent-seal)] text-[var(--text-primary)] font-medium'
                  : 'border-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)]',
              ]}
            >
              {c.name} ({c.count})
            </a>
          );
        })
      }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
