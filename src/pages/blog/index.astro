---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getCategoriesMap, getTagsMap } from '../../utils/blog';

const posts = await getPublishedPosts();
const categories = getCategoriesMap(posts);
const tags = getTagsMap(posts);
---

<BaseLayout title="全部文章" description="浏览无极 (WuJi) 的全部技术博客、数学笔记与架构文章。">
  <section class="max-w-5xl mx-auto px-5 sm:px-8 pt-8 pb-20">
    <!-- Header -->
    <header class="pb-8 border-b border-[var(--border-strong)]">
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] font-editorial tracking-wide">
        文集
      </h1>
      <p class="mt-3 text-sm text-[var(--text-secondary)]">
        共收录 <span class="font-mono text-[var(--text-primary)]">{posts.length}</span> 篇文字，可按卷目或关键词即时检索。
      </p>
    </header>

    <!-- Quiet Filter Toolbar -->
    <div class="mt-7 pb-6 border-b border-[var(--border-hairline)] space-y-5">
      <div class="flex flex-col sm:flex-row gap-3 sm:items-center justify-between">
        <div class="relative flex-1 max-w-sm">
          <input
            id="blog-filter-input"
            type="text"
            placeholder="过滤标题、摘要或标签…"
            class="w-full px-3.5 py-2 rounded-[3px] text-sm bg-[var(--bg-surface)] border border-[var(--border-hairline)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--border-strong)]"
          />
        </div>

        <div class="flex items-center gap-4 text-xs text-[var(--text-muted)]">
          <select
            id="blog-sort-select"
            aria-label="排序方式"
            class="px-2.5 py-1.5 rounded-[3px] text-xs bg-[var(--bg-surface)] border border-[var(--border-hairline)] text-[var(--text-secondary)] focus:outline-none cursor-pointer"
          >
            <option value="default">默认排序（置顶优先）</option>
            <option value="newest">最新发布</option>
            <option value="oldest">最早发布</option>
            <option value="longest">长文优先</option>
          </select>
          <span id="blog-visible-count" class="font-mono whitespace-nowrap">
            共 {posts.length} 篇
          </span>
        </div>
      </div>

      <!-- Category Tabs -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm" id="blog-cat-pills">
        <button
          type="button"
          data-cat="ALL"
          class="cat-pill pb-1 border-b-2 border-[var(--accent-seal)] text-[var(--text-primary)] font-medium transition-colors cursor-pointer"
        >
          全部 ({posts.length})
        </button>
        {
          categories.map((cat) => (
            <button
              type="button"
              data-cat={cat.name}
              class="cat-pill pb-1 border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
            >
              {cat.name} ({cat.count})
            </button>
          ))
        }
      </div>

      <!-- Quiet Tag Links -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs font-mono text-[var(--text-muted)]">
        <span class="font-sans">常用标签：</span>
        {
          tags.slice(0, 10).map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag.name)}/`}
              class="hover:text-[var(--accent-seal)] transition-colors"
            >
              #{tag.name}
            </a>
          ))
        }
      </div>
    </div>

    <!-- 2-Column Editorial Posts Grid -->
    <div id="blog-posts-grid" class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <!-- Empty State -->
    <div id="blog-empty-state" class="hidden py-20 text-center space-y-2">
      <p class="text-sm text-[var(--text-secondary)]">未检索到符合条件的文字</p>
      <button
        id="blog-reset-btn"
        type="button"
        class="text-xs text-[var(--accent-seal)] hover:underline cursor-pointer"
      >
        重置筛选
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  const grid = document.getElementById('blog-posts-grid');
  const input = document.getElementById('blog-filter-input') as HTMLInputElement | null;
  const sortSelect = document.getElementById('blog-sort-select') as HTMLSelectElement | null;
  const countEl = document.getElementById('blog-visible-count');
  const emptyEl = document.getElementById('blog-empty-state');
  const resetBtn = document.getElementById('blog-reset-btn');
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-pill'));
  const cards = grid ? (Array.from(grid.children) as HTMLElement[]) : [];

  let activeCat = 'ALL';

  function applyFilters() {
    const q = (input?.value || '').trim().toLowerCase();
    const sortMode = sortSelect?.value || 'default';

    const ordered = [...cards];
    if (sortMode === 'newest') {
      ordered.sort((a, b) => Number(b.dataset.date) - Number(a.dataset.date));
    } else if (sortMode === 'oldest') {
      ordered.sort((a, b) => Number(a.dataset.date) - Number(b.dataset.date));
    } else if (sortMode === 'longest') {
      ordered.sort((a, b) => Number(b.dataset.reading) - Number(a.dataset.reading));
    }
    ordered.forEach((el) => grid?.appendChild(el));

    let visible = 0;
    for (const card of ordered) {
      const cat = card.dataset.category || '';
      const title = card.dataset.title || '';
      const summary = card.dataset.summary || '';
      const tags = (card.dataset.tags || '').toLowerCase();

      const catOk = activeCat === 'ALL' || cat === activeCat;
      const queryOk = !q || title.includes(q) || summary.includes(q) || tags.includes(q) || cat.toLowerCase().includes(q);
      const show = catOk && queryOk;

      card.classList.toggle('hidden', !show);
      if (show) visible++;
    }

    if (countEl) countEl.textContent = `共 ${visible} 篇`;
    emptyEl?.classList.toggle('hidden', visible > 0);
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeCat = pill.dataset.cat || 'ALL';
      pills.forEach((p) => {
        const isCurrent = p === pill;
        p.className = isCurrent
          ? 'cat-pill pb-1 border-b-2 border-[var(--accent-seal)] text-[var(--text-primary)] font-medium transition-colors cursor-pointer'
          : 'cat-pill pb-1 border-b-2 border-transparent text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer';
      });
      applyFilters();
    });
  });

  input?.addEventListener('input', applyFilters);
  sortSelect?.addEventListener('change', applyFilters);
  resetBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    if (sortSelect) sortSelect.value = 'default';
    pills[0]?.click();
  });
</script>
