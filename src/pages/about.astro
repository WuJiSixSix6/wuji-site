---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { getPublishedPosts, getTotalStats } from '../utils/blog';

const posts = await getPublishedPosts();
const stats = getTotalStats(posts);

const capabilities = [
  {
    num: '01',
    title: 'Markdown 直转静态网页',
    desc: '向 src/content/blog/ 放入 .md 或 .mdx 文稿，编译期即生成完整静态页面、SEO 信息、RSS 与站点地图。',
  },
  {
    num: '02',
    title: 'KaTeX 数学公式排版',
    desc: '原生支持行内与块级 LaTeX 数学公式，字体与样式本地打包，零外部阻塞。',
  },
  {
    num: '03',
    title: 'Shiki 双主题代码刊刻',
    desc: '随宣纸 / 墨夜模式自动切换语法配色，内置行号、语言标识与一键复制。',
  },
  {
    num: '04',
    title: '哔哩哔哩与多平台视频',
    desc: '纯 Markdown 一行指令即可嵌入 B 站（BV号）、YouTube 或直链 MP4 影画卡片。',
  },
  {
    num: '05',
    title: '全站本地检索与互动墨韵',
    desc: '快捷键 ⌘K 毫秒级检索全文；内置自动休眠的水墨笔迹、墨晕与卷尾朱砂落印。',
  },
  {
    num: '06',
    title: 'GitHub Actions 自动发布',
    desc: '源码托管于 GitHub，每次 git push 自动触发编译并同步至香港云服务器 Nginx（HTTP/2 + HTTPS）。',
  },
];
---

<BaseLayout title="关于无极" description="认识无极 (WuJi) 与这座数字花园背后的设计理念和技术架构。">
  <section class="max-w-4xl mx-auto px-5 sm:px-8 pt-8 pb-20 space-y-14">
    <!-- Monograph Header -->
    <header class="pb-10 border-b border-[var(--border-strong)]">
      <div class="flex items-center gap-3.5">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-[0.14em] text-[var(--text-primary)] font-editorial">
          无极
        </h1>
        <span class="wuji-seal w-7 h-7 text-xs">无极</span>
        <span class="text-xs font-mono tracking-[0.22em] text-[var(--text-muted)] uppercase pl-1">
          WuJi
        </span>
      </div>

      <p class="mt-6 text-base sm:text-lg text-[var(--text-secondary)] leading-[1.95] max-w-2xl font-editorial">
        「{SITE.tagline}」这里记录计算机科学、数学推导、前端美学与系统架构的长期思考。
        不求喧哗，但求每一篇文字经得起反复回看。
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
        <div class="flex flex-wrap items-center gap-4 font-mono">
          <span>藏文 {stats.postCount} 篇</span>
          <span>·</span>
          <span>累计 {stats.totalWords.toLocaleString()} 字</span>
          <span>·</span>
          <span>{stats.categoryCount} 卷目 / {stats.tagCount} 标签</span>
        </div>
        <div class="flex items-center gap-5">
          <a
            href={SITE.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors"
          >
            GitHub · WuJiSixSix6 ↗
          </a>
          <a
            href="/rss.xml"
            class="text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors"
          >
            RSS 订阅
          </a>
        </div>
      </div>
    </header>

    <!-- Philosophy -->
    <section class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-4">
        <h2 class="text-sm font-editorial tracking-[0.2em] text-[var(--text-muted)]">
          为何名为「无极」
        </h2>
      </div>
      <div class="md:col-span-8 space-y-4 text-[15px] text-[var(--text-secondary)] leading-[1.92]">
        <p>
          无极意味着不被既有边界所困：既追求底层原理的数学严谨，也钟情于文字与界面的克制美感；既能深入复杂系统的工程肌理，也懂得在表达上做减法。
        </p>
        <p>
          全站采用零外部阻塞的静态预渲染架构，告别臃肿的后台与冗杂的视觉噪音，让内容成为唯一的主角。
        </p>
      </div>
    </section>

    <hr class="ink-rule" />

    <!-- Capabilities Ruled Index -->
    <section>
      <h2 class="text-sm font-editorial tracking-[0.2em] text-[var(--text-muted)] mb-6">
        站点架构与能力
      </h2>
      <div class="border-t border-[var(--border-strong)]">
        {
          capabilities.map((cap) => (
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6 py-5 border-b border-[var(--border-hairline)] items-baseline">
              <div class="sm:col-span-4 flex items-baseline gap-3">
                <span class="font-mono text-xs text-[var(--text-muted)]">{cap.num}</span>
                <h3 class="text-[15px] font-bold font-editorial text-[var(--text-primary)]">
                  {cap.title}
                </h3>
              </div>
              <p class="sm:col-span-8 text-sm text-[var(--text-secondary)] leading-relaxed pl-7 sm:pl-0">
                {cap.desc}
              </p>
            </div>
          ))
        }
      </div>
    </section>
  </section>
</BaseLayout>
