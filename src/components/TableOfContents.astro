---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  tocItems.length > 0 && (
    <aside class="wuji-toc" aria-label="文章目录">
      <!-- Desktop Sticky Editorial TOC -->
      <div class="hidden xl:block sticky top-24 max-h-[calc(100vh-7.5rem)] overflow-y-auto pl-4 border-l border-[var(--border-hairline)]">
        <div class="text-xs font-editorial tracking-[0.2em] text-[var(--text-muted)] mb-3">
          目录
        </div>
        <nav>
          <ul class="space-y-1.5 text-[13px] leading-snug" id="wuji-toc-list">
            {tocItems.map((heading) => (
              <li class={heading.depth === 3 ? 'pl-3' : ''}>
                <a
                  href={`#${heading.slug}`}
                  data-toc-slug={heading.slug}
                  class="wuji-toc-link block py-1 text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Mobile Collapsible TOC -->
      <details class="xl:hidden mb-8 border border-[var(--border-hairline)] bg-[var(--bg-surface)] rounded-[3px] overflow-hidden group">
        <summary class="flex items-center justify-between px-4 py-3 cursor-pointer select-none text-sm font-editorial text-[var(--text-primary)]">
          <span>目录（{tocItems.length} 节）</span>
          <span class="text-xs font-mono text-[var(--text-muted)] group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <ul class="px-4 pb-4 pt-2 space-y-1.5 border-t border-[var(--border-hairline)] text-sm">
          {tocItems.map((heading) => (
            <li class={heading.depth === 3 ? 'pl-4' : ''}>
              <a
                href={`#${heading.slug}`}
                class="block py-1 text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </aside>
  )
}

<script>
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.wuji-toc-link'));
  if (tocLinks.length > 0) {
    const headings = tocLinks
      .map((link) => {
        const slug = link.dataset.tocSlug;
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => Boolean(el));

    function setActive(slug: string) {
      tocLinks.forEach((link) => {
        const isCurrent = link.dataset.tocSlug === slug;
        link.classList.toggle('text-[var(--accent-seal)]', isCurrent);
        link.classList.toggle('font-medium', isCurrent);
        link.classList.toggle('text-[var(--text-muted)]', !isCurrent);
      });
    }

    if (headings[0]) setActive(headings[0].id);

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length > 0) setActive(visible[0].target.id);
      },
      { rootMargin: '-88px 0px -65% 0px', threshold: 0.1 }
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>
