---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getChronologicalPosts,
  groupPostsByYearMonth,
  computePostMeta,
  getTotalStats,
} from '../utils/blog';

const posts = await getChronologicalPosts();
const archiveGroups = groupPostsByYearMonth(posts);
const stats = getTotalStats(posts);
---

<BaseLayout title="文章归档" description="按时间轴浏览无极 (WuJi) 的全部历史文章与笔记归档。">
  <section class="max-w-4xl mx-auto px-5 sm:px-8 pt-8 pb-20">
    <header class="pb-8 border-b border-[var(--border-strong)] mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] font-editorial tracking-wide">
        编年归档
      </h1>
      <p class="mt-3 text-sm text-[var(--text-secondary)]">
        共 <span class="font-mono text-[var(--text-primary)]">{stats.postCount}</span> 篇，累计约{' '}
        <span class="font-mono text-[var(--text-primary)]">{stats.totalWords.toLocaleString()}</span> 字。
      </p>
    </header>

    <div class="space-y-14">
      {
        archiveGroups.map((group) => (
          <section class="ink-reveal">
            <div class="flex items-baseline justify-between pb-3 border-b border-[var(--border-strong)] mb-6">
              <h2 class="text-2xl sm:text-3xl font-bold font-editorial text-[var(--text-primary)] tracking-wider">
                {group.year}
              </h2>
              <span class="text-xs font-mono text-[var(--text-muted)]">
                {group.total} 篇
              </span>
            </div>

            <div class="space-y-8">
              {group.months.map((mGroup) => (
                <div class="grid grid-cols-1 sm:grid-cols-[84px_minmax(0,1fr)] gap-3 sm:gap-6 items-baseline">
                  <div class="text-xs font-mono text-[var(--text-muted)] tracking-wider pt-1">
                    {String(mGroup.month).padStart(2, '0')} 月
                  </div>

                  <div class="divide-y divide-[var(--border-hairline)]">
                    {mGroup.posts.map((post) => {
                      const meta = computePostMeta(post.body);
                      const day = String(post.data.pubDate.getDate()).padStart(2, '0');
                      const month = String(post.data.pubDate.getMonth() + 1).padStart(2, '0');
                      return (
                        <a
                          href={`/blog/${post.id}/`}
                          class="group flex flex-col sm:flex-row sm:items-baseline justify-between gap-1.5 py-3.5 hover:pl-1.5 transition-all"
                        >
                          <div class="flex items-baseline gap-4 min-w-0">
                            <span class="shrink-0 text-xs font-mono text-[var(--text-muted)]">
                              {month}.{day}
                            </span>
                            <span class="text-[15px] sm:text-base font-medium font-editorial text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] transition-colors line-clamp-1">
                              {post.data.title}
                            </span>
                          </div>

                          <div class="flex items-center gap-3 shrink-0 pl-12 sm:pl-0 text-xs text-[var(--text-muted)]">
                            <span>「{post.data.category}」</span>
                            <span class="font-mono">{meta.readingMinutes}m</span>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
