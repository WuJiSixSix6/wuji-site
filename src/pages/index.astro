---
import BaseLayout from '../layouts/BaseLayout.astro';
import InkHeroScene from '../components/InkHeroScene.astro';
import PostCard from '../components/PostCard.astro';
import WuJiLogo from '../components/WuJiLogo.astro';
import { SITE, getCategoryMeta } from '../data/site';
import {
  getPublishedPosts,
  getCategoriesMap,
  getTotalStats,
  computePostMeta,
  formatDate,
} from '../utils/blog';

const posts = await getPublishedPosts();
const stats = getTotalStats(posts);
const categories = getCategoriesMap(posts);

const featuredPosts = posts.filter((p) => p.data.featured || p.data.pinned).slice(0, 3);
const primaryFeatured = featuredPosts[0] || posts[0];
const secondaryFeatured = featuredPosts.slice(1, 3);
const latestPosts = posts.slice(0, 6);
---

<BaseLayout title={SITE.title} description={SITE.heroSubtitle}>
  <!-- =========================================================
       CHINESE INK WASH SHAN-SHUI HERO SECTION
       ========================================================= -->
  <section class="relative -mt-24 pt-36 pb-24 sm:pt-44 sm:pb-32 overflow-hidden">
    <InkHeroScene />

    <!-- Vertical Classical Scroll Inscription (右侧立轴题跋) -->
    <div
      class="hidden lg:flex flex-col items-center gap-4 absolute right-8 xl:right-14 top-36 z-10 select-none pointer-events-none opacity-60"
      aria-hidden="true"
    >
      <span class="vertical-inscription text-xs text-[var(--text-secondary)] font-serif">
        道生一 · 一生二 · 二生三 · 三生万物
      </span>
      <span class="wuji-seal w-6 h-12 text-xs vertical-inscription tracking-normal py-1">
        无极
      </span>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <!-- Interactive Poetic Quote Switcher (无极诗笺 · 点击换签) -->
        <button
          id="wuji-motto-btn"
          type="button"
          class="group inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-[var(--border-strong)] bg-[var(--bg-surface)]/80 backdrop-blur-md text-xs text-[var(--text-secondary)] hover:border-[var(--accent-seal)]/55 transition-all mb-7 cursor-pointer"
          title="点击切换无极诗笺"
        >
          <span class="wuji-seal w-4.5 h-4.5 text-[10px]">签</span>
          <span id="wuji-motto-text" class="transition-opacity duration-300 font-serif">
            无极而太极，极简而深邃。
          </span>
          <span class="text-[10px] font-mono text-[var(--accent-seal)] opacity-75 group-hover:opacity-100">
            换签 ↻
          </span>
        </button>

        <!-- Dramatic Calligraphy Hero Title -->
        <h1 class="flex flex-wrap items-end gap-x-4 gap-y-2">
          <span
            class="text-7xl sm:text-8xl lg:text-[6.5rem] leading-[0.95] text-[var(--text-primary)] font-calligraphy tracking-wide"
          >
            无极
          </span>
          <span class="wuji-seal px-2.5 py-1.5 text-lg sm:text-xl mb-2 -rotate-3">
            之印
          </span>
          <span
            class="text-2xl sm:text-3xl font-mono font-semibold tracking-[0.22em] uppercase text-[var(--text-muted)] mb-2 ml-1"
          >
            WUJI
          </span>
        </h1>

        <p class="mt-6 text-base sm:text-lg text-[var(--text-secondary)] leading-loose max-w-2xl">
          {SITE.heroSubtitle}
        </p>

        <!-- Primary Magnetic CTAs -->
        <div class="mt-9 flex flex-wrap items-center gap-3.5">
          <a
            href="/blog"
            class="ink-magnetic inline-flex items-center gap-2 px-6 py-3 rounded-xl font-medium text-sm text-[#fbf6ee] shadow-[0_12px_28px_-10px_rgba(185,43,39,0.55)] cursor-pointer"
            style="background: linear-gradient(135deg, #c93832 0%, #a6231f 100%);"
          >
            <span>展卷阅文</span>
            <span aria-hidden="true">→</span>
          </a>

          <a
            href="/archive"
            class="ink-magnetic inline-flex items-center gap-2 px-5 py-3 rounded-xl font-medium text-sm border border-[var(--border-strong)] bg-[var(--bg-surface)]/85 backdrop-blur-md text-[var(--text-primary)] hover:border-[var(--accent-seal)] hover:text-[var(--accent-seal)] transition-colors"
          >
            <span>岁月归档</span>
          </a>

          <a
            href="/about"
            class="ink-magnetic inline-flex items-center gap-2 px-5 py-3 rounded-xl font-medium text-sm border border-[var(--border-hairline)] bg-[var(--bg-surface)]/55 text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-colors"
          >
            <span>关于无极</span>
          </a>
        </div>

        <!-- Interactive Ink-Wash Studio Bar (水墨雅玩互动台) -->
        <div class="mt-8 inline-flex flex-wrap items-center gap-2 p-2 rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)]/78 backdrop-blur-md shadow-sm">
          <span class="px-2.5 text-[11px] font-mono text-[var(--text-muted)] tracking-wider">
            ✦ 雅玩互动
          </span>
          <button
            id="hero-btn-splash"
            type="button"
            class="ink-magnetic px-3 py-1.5 rounded-xl text-xs font-medium bg-[var(--ink-primary)] text-[var(--bg-canvas)] hover:opacity-90 transition-opacity cursor-pointer"
          >
            泼墨一笔
          </button>
          <button
            id="hero-btn-stamp"
            type="button"
            class="ink-magnetic px-3 py-1.5 rounded-xl text-xs font-medium bg-[var(--accent-seal-soft)] text-[var(--accent-seal)] border border-[var(--accent-seal)]/35 hover:bg-[var(--accent-seal)] hover:text-[#fbf5ec] transition-colors cursor-pointer"
          >
            朱砂落印
          </button>
          <button
            id="hero-btn-mode"
            type="button"
            class="ink-magnetic px-3 py-1.5 rounded-xl text-xs font-medium bg-[var(--accent-jade-soft)] text-[var(--accent-jade)] border border-[var(--accent-jade)]/35 hover:bg-[var(--accent-jade)] hover:text-[#fbf5ec] transition-colors cursor-pointer"
          >
            宣纸 / 墨夜
          </button>
          <button
            id="hero-btn-clear"
            type="button"
            class="px-2.5 py-1.5 rounded-xl text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
          >
            拂尘
          </button>
        </div>
      </div>

      <!-- Telemetry Stats Strip -->
      <div class="mt-14 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-3xl">
        <div class="px-4 py-3.5 rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)]/80 backdrop-blur-md">
          <div class="text-2xl font-bold font-mono text-[var(--text-primary)]">{stats.postCount}</div>
          <div class="text-xs text-[var(--text-muted)] mt-0.5">藏卷篇数 · Posts</div>
        </div>
        <div class="px-4 py-3.5 rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)]/80 backdrop-blur-md">
          <div class="text-2xl font-bold font-mono text-[var(--accent-seal)]">
            {(stats.totalWords / 1000).toFixed(1)}k
          </div>
          <div class="text-xs text-[var(--text-muted)] mt-0.5">笔耕字数 · Words</div>
        </div>
        <div class="px-4 py-3.5 rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)]/80 backdrop-blur-md">
          <div class="text-2xl font-bold font-mono text-[var(--accent-jade)]">{stats.categoryCount}</div>
          <div class="text-xs text-[var(--text-muted)] mt-0.5">专题卷目 · Topics</div>
        </div>
        <div class="px-4 py-3.5 rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)]/80 backdrop-blur-md">
          <div class="text-2xl font-bold font-mono text-[var(--text-primary)]">{stats.tagCount}</div>
          <div class="text-xs text-[var(--text-muted)] mt-0.5">知识墨签 · Tags</div>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6"><hr class="ink-divider" /></div>

  <!-- =========================================================
       FEATURED BENTO SHOWCASE (精选画卷)
       ========================================================= -->
  {
    primaryFeatured && (
      <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 pb-16">
        <div class="flex items-end justify-between gap-4 mb-8 ink-reveal">
          <div>
            <p class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--accent-seal)]">
              Curated Scroll · 卷首精选
            </p>
            <h2
              class="mt-1.5 text-2xl sm:text-3xl font-bold text-[var(--text-primary)]"
              style="font-family: var(--font-serif);"
            >
              置顶与代表作
            </h2>
          </div>
          <a
            href="/blog"
            class="text-xs sm:text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors"
          >
            查看全部 →
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
          {(() => {
            const meta = computePostMeta(primaryFeatured.body);
            return (
              <a
                href={`/blog/${primaryFeatured.id}`}
                class:list={[
                  'lg:col-span-7 wuji-card wuji-card-interactive ink-reveal group relative rounded-2xl overflow-hidden p-7 sm:p-9 flex flex-col justify-between min-h-[340px]',
                  `cover-${primaryFeatured.data.coverTheme || 'celestial-gold'}`,
                ]}
              >
                <!-- Subtle Ink Mountain Overlay -->
                <svg
                  class="absolute inset-x-0 bottom-0 w-full h-36 text-white opacity-[0.09] group-hover:opacity-[0.15] transition-opacity duration-500 pointer-events-none"
                  viewBox="0 0 600 150"
                  preserveAspectRatio="none"
                  fill="currentColor"
                >
                  <path d="M0,125 C85,80 150,45 245,75 C330,102 415,28 515,62 C558,76 582,82 600,70 L600,150 L0,150 Z" />
                </svg>

                <div class="absolute right-6 top-6 opacity-25 group-hover:opacity-45 group-hover:rotate-12 transition-all duration-700 pointer-events-none">
                  <WuJiLogo size={84} />
                </div>

                <div class="relative z-10 flex flex-wrap items-center gap-2.5">
                  <span class="wuji-seal px-2.5 py-1 text-xs tracking-widest">
                    卷首置顶
                  </span>
                  <span class="px-3 py-1 rounded-lg text-xs font-medium bg-black/40 backdrop-blur-md text-[#f4ece0] border border-white/15">
                    {primaryFeatured.data.category}
                  </span>
                </div>

                <div class="relative z-10 mt-10">
                  <h3
                    class="text-2xl sm:text-3xl font-bold text-[#f9f4eb] leading-snug group-hover:text-[#ffd6ce] transition-colors"
                    style="font-family: var(--font-serif);"
                  >
                    {primaryFeatured.data.title}
                  </h3>
                  <p class="mt-3 text-sm sm:text-base text-white/75 leading-relaxed line-clamp-3 max-w-xl">
                    {primaryFeatured.data.summary}
                  </p>
                  <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-5 border-t border-white/15 text-xs font-mono text-white/75">
                    <div class="flex items-center gap-3">
                      <span>{formatDate(primaryFeatured.data.pubDate)}</span>
                      <span>·</span>
                      <span>{meta.readingMinutes} 分钟阅读</span>
                      <span>·</span>
                      <span>{meta.wordCount.toLocaleString()} 字</span>
                    </div>
                    <span class="text-[#f7d8d0] font-sans font-medium group-hover:translate-x-1 transition-transform">
                      展卷品读 →
                    </span>
                  </div>
                </div>
              </a>
            );
          })()}

          <div class="lg:col-span-5 flex flex-col gap-5">
            {secondaryFeatured.map((post) => {
              const meta = computePostMeta(post.body);
              return (
                <a
                  href={`/blog/${post.id}`}
                  class="wuji-card wuji-card-interactive ink-reveal group flex-1 p-6 flex flex-col justify-between"
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 text-xs mb-3">
                      <span class="px-2.5 py-0.5 rounded-lg bg-[var(--accent-jade-soft)] text-[var(--accent-jade)] font-medium">
                        {post.data.category}
                      </span>
                      <span class="font-mono text-[var(--text-muted)]">
                        {formatDate(post.data.pubDate)}
                      </span>
                    </div>
                    <h3
                      class="text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] transition-colors line-clamp-2"
                      style="font-family: var(--font-serif);"
                    >
                      {post.data.title}
                    </h3>
                    <p class="mt-2 text-sm text-[var(--text-secondary)] line-clamp-2 leading-relaxed">
                      {post.data.summary}
                    </p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-[var(--border-hairline)] flex items-center justify-between text-xs font-mono text-[var(--text-muted)]">
                    <span>{meta.readingMinutes} 分钟 · {meta.wordCount.toLocaleString()} 字</span>
                    <span class="text-[var(--accent-seal)] font-sans group-hover:translate-x-0.5 transition-transform">
                      阅读 →
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- =========================================================
       LATEST ARTICLES GRID
       ========================================================= -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex items-end justify-between gap-4 mb-8 ink-reveal">
      <div>
        <p class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--accent-jade)]">
          Latest Essays · 近期新篇
        </p>
        <h2
          class="mt-1.5 text-2xl sm:text-3xl font-bold text-[var(--text-primary)]"
          style="font-family: var(--font-serif);"
        >
          最新博客文章
        </h2>
      </div>
      <a
        href="/blog"
        class="text-xs sm:text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors"
      >
        进入藏书阁 →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- =========================================================
       CATEGORIES MATRIX
       ========================================================= -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex items-end justify-between gap-4 mb-8 ink-reveal">
      <div>
        <p class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--accent-seal)]">
          Dimensions · 卷目维度
        </p>
        <h2
          class="mt-1.5 text-2xl sm:text-3xl font-bold text-[var(--text-primary)]"
          style="font-family: var(--font-serif);"
        >
          专题分类导览
        </h2>
      </div>
      <a
        href="/categories"
        class="text-xs sm:text-sm font-medium text-[var(--text-secondary)] hover:text-[var(--accent-seal)] transition-colors"
      >
        全部分类 →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        categories.map((cat) => {
          const meta = getCategoryMeta(cat.name);
          return (
            <a
              href={`/categories/${encodeURIComponent(cat.name)}`}
              class="wuji-card wuji-card-interactive ink-reveal group p-5 flex items-start gap-4"
            >
              <div class="shrink-0 w-11 h-11 rounded-xl bg-[var(--accent-seal-soft)] border border-[var(--accent-seal)]/25 flex items-center justify-center text-lg text-[var(--accent-seal)] group-hover:scale-105 transition-transform">
                {meta.glyph}
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-seal)] transition-colors">
                    {cat.name}
                  </h3>
                  <span class="text-xs font-mono px-2 py-0.5 rounded-lg bg-[var(--bg-elevated)] text-[var(--text-muted)]">
                    {cat.count} 篇
                  </span>
                </div>
                <p class="mt-1.5 text-xs text-[var(--text-secondary)] leading-relaxed line-clamp-2">
                  {meta.desc}
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Interactive poetic motto switcher (无极诗笺)
  const mottos = [
    '无极而太极，极简而深邃。',
    '以代码筑器，以水墨载道。',
    '山高月小，水落石出，架构亦然。',
    '静水流深，繁华落尽见真淳。',
    '万物并作，吾以观复，精微致广大。',
  ];
  let mottoIdx = 0;
  const mottoBtn = document.getElementById('wuji-motto-btn');
  const mottoText = document.getElementById('wuji-motto-text');

  mottoBtn?.addEventListener('click', (e) => {
    mottoIdx = (mottoIdx + 1) % mottos.length;
    if (mottoText) {
      mottoText.style.opacity = '0';
      setTimeout(() => {
        mottoText.textContent = mottos[mottoIdx];
        mottoText.style.opacity = '1';
      }, 180);
    }
    window.dispatchEvent(
      new CustomEvent('wuji-ink-splash', {
        detail: { x: e.clientX, y: e.clientY, isRed: true, big: false },
      })
    );
  });

  // Hero interactive studio bar controls
  const stampWords = ['无极', '清雅', '悟道', '极境', '墨韵'];
  let stampIdx = 0;

  document.getElementById('hero-btn-splash')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('wuji-hero-splash', { detail: { isRed: Math.random() < 0.25 } }));
    window.dispatchEvent(new CustomEvent('wuji-ink-splash', { detail: { isRed: false, big: true } }));
  });

  document.getElementById('hero-btn-stamp')?.addEventListener('click', () => {
    const word = stampWords[stampIdx % stampWords.length];
    stampIdx++;
    window.dispatchEvent(
      new CustomEvent('wuji-stamp-effect', {
        detail: {
          x: window.innerWidth * (0.48 + Math.random() * 0.34),
          y: window.innerHeight * (0.22 + Math.random() * 0.38),
          text: word,
        },
      })
    );
  });

  document.getElementById('hero-btn-mode')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('wuji-request-theme-toggle'));
  });

  document.getElementById('hero-btn-clear')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('wuji-hero-clear'));
  });
</script>
