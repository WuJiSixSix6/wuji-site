---
import { SITE, NAV_LINKS } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="relative z-10 mt-20 border-t border-[var(--border-hairline)]">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 py-12">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-8">
      <div class="space-y-2">
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="text-lg font-bold font-editorial tracking-[0.18em] text-[var(--text-primary)]">
            {SITE.name}
          </span>
          <span class="wuji-seal w-4.5 h-4.5 text-[10px]">印</span>
          <span class="text-xs font-mono tracking-[0.2em] text-[var(--text-muted)]">
            {SITE.enName}
          </span>
        </a>
        <p class="text-xs text-[var(--text-muted)]">
          {SITE.tagline} 轻点页面可晕染墨韵，顶部「墨韵」可随时启停。
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-[var(--text-muted)]">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} class="hover:text-[var(--text-primary)] transition-colors">
              {link.label}
            </a>
          ))
        }
        <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)] transition-colors">
          GitHub ↗
        </a>
        <a href="/rss.xml" class="hover:text-[var(--accent-seal)] transition-colors">
          RSS
        </a>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-[var(--border-hairline)] flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-[var(--text-muted)]">
      <p>© {year} {SITE.author}</p>
      <p class="font-editorial tracking-widest">道生一 · 一生二 · 二生三 · 三生万物</p>
    </div>
  </div>
</footer>
