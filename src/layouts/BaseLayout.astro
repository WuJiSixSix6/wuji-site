---
import '../styles/global.css';
import { SITE } from '../data/site';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandSearch from '../components/CommandSearch.astro';
import InkHeroScene from '../components/InkHeroScene.astro';
import InkInteractionCanvas from '../components/InkInteractionCanvas.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title = SITE.title,
  description = SITE.heroSubtitle,
  ogType = 'website',
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} | ${SITE.shortTitle}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.shortTitle} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <title>{pageTitle}</title>

    <!-- Zero-flash theme init: Default is Xuan Paper Ink Wash (light); .dark is Nocturnal Ink -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('wuji-ink-theme');
        if (stored === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>

  <body class="relative flex flex-col min-h-screen">
    <!-- Global Living Seasonal & Astronomical Ink-Wash Backdrop (All Pages & Articles) -->
    <InkHeroScene />

    <!-- Auto-sleeping Interactive Ink Canvas (0% CPU when idle) -->
    <InkInteractionCanvas />

    <Navbar />

    <main class="relative z-10 flex-1 pt-24">
      <slot />
    </main>

    <Footer />
    <CommandSearch />

    <!-- Image Lightbox Modal -->
    <div
      id="wuji-lightbox"
      class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/85 cursor-zoom-out"
      aria-hidden="true"
    >
      <img
        id="wuji-lightbox-img"
        src=""
        alt=""
        class="max-w-[92vw] max-h-[88vh] rounded-2xl border border-white/15 shadow-2xl object-contain"
      />
    </div>

    <!-- Global Lightweight Interactive Engine -->
    <script>
      // 1. Code block copy buttons
      document.querySelectorAll<HTMLButtonElement>('.wuji-copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const block = btn.closest('.wuji-code-block');
          const codeEl = block?.querySelector('pre code');
          if (!codeEl) return;

          const lines = Array.from(codeEl.querySelectorAll('.line')).map((l) => l.textContent ?? '');
          const text = lines.length > 0 ? lines.join('\n') : codeEl.textContent || '';

          try {
            await navigator.clipboard.writeText(text);
            const label = btn.querySelector('.wuji-copy-label');
            btn.classList.add('copied');
            if (label) label.textContent = '已复制 ✓';
            setTimeout(() => {
              btn.classList.remove('copied');
              if (label) label.textContent = '复制';
            }, 1800);
          } catch {
            // Fallback
          }
        });
      });

      // 2. Image lightbox
      const lightbox = document.getElementById('wuji-lightbox');
      const lightboxImg = document.getElementById('wuji-lightbox-img') as HTMLImageElement | null;
      document.querySelectorAll<HTMLImageElement>('.wuji-prose img').forEach((img) => {
        img.addEventListener('click', () => {
          if (!lightbox || !lightboxImg) return;
          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt;
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
        });
      });
      lightbox?.addEventListener('click', () => {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
      });

      // 3. Scroll-triggered Ink Unfold Reveal (GPU-only opacity + translateY)
      const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.ink-reveal'));
      if (revealEls.length > 0 && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px -20px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // 4. rAF-throttled 3D Tilt + Radial Ink Spotlight & Magnetic Buttons
      if (window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('.wuji-card-interactive').forEach((card) => {
          let rafPending = false;
          let lastX = 0;
          let lastY = 0;
          card.addEventListener(
            'pointermove',
            (e) => {
              lastX = e.clientX;
              lastY = e.clientY;
              if (rafPending) return;
              rafPending = true;
              requestAnimationFrame(() => {
                rafPending = false;
                const rect = card.getBoundingClientRect();
                const x = lastX - rect.left;
                const y = lastY - rect.top;
                card.style.setProperty('--mx', `${x.toFixed(0)}px`);
                card.style.setProperty('--my', `${y.toFixed(0)}px`);
                const rx = (y / rect.height - 0.5) * -4.2;
                const ry = (x / rect.width - 0.5) * 4.2;
                card.style.transform = `perspective(900px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateY(-3px)`;
              });
            },
            { passive: true }
          );
          card.addEventListener('pointerleave', () => {
            card.style.transform = '';
          });
        });

        document.querySelectorAll<HTMLElement>('.ink-magnetic').forEach((el) => {
          let rafPending = false;
          let lastX = 0;
          let lastY = 0;
          el.addEventListener(
            'pointermove',
            (e) => {
              lastX = e.clientX;
              lastY = e.clientY;
              if (rafPending) return;
              rafPending = true;
              requestAnimationFrame(() => {
                rafPending = false;
                const rect = el.getBoundingClientRect();
                const dx = (lastX - (rect.left + rect.width / 2)) * 0.14;
                const dy = (lastY - (rect.top + rect.height / 2)) * 0.14;
                el.style.transform = `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0)`;
              });
            },
            { passive: true }
          );
          el.addEventListener('pointerleave', () => {
            el.style.transform = '';
          });
        });
      }
    </script>
  </body>
</html>
