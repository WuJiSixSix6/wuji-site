---
import { SITE, NAV_LINKS } from '../data/site';
import WuJiLogo from './WuJiLogo.astro';

const year = new Date().getFullYear();
---

<footer class="relative mt-24 border-t border-[var(--border-hairline)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
      <!-- Brand Identity -->
      <div class="space-y-3.5">
        <a href="/" class="inline-flex items-center gap-2.5">
          <WuJiLogo size={30} />
          <div class="flex items-baseline gap-2">
            <span class="text-lg font-bold tracking-wider text-[var(--text-primary)]" style="font-family: var(--font-serif);">
              {SITE.name}
            </span>
            <span class="text-xs font-mono tracking-[0.2em] uppercase text-[var(--accent-gold)]">
              {SITE.enName}
            </span>
          </div>
        </a>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed max-w-xs">
          {SITE.tagline} 记录工程实践、数学原理与技术哲学。
        </p>
      </div>

      <!-- Navigation -->
      <div class="space-y-3">
        <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-muted)]">
          Explore · 索引
        </h3>
        <div class="grid grid-cols-2 gap-y-2 gap-x-6 text-sm">
          {
            NAV_LINKS.map((link) => (
              <a
                href={link.href}
                class="text-[var(--text-secondary)] hover:text-[var(--accent-gold)] transition-colors"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Connections -->
      <div class="space-y-3">
        <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--text-muted)]">
          Connect · 联结
        </h3>
        <div class="flex flex-wrap items-center gap-2.5">
          <a
            href={SITE.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--accent-gold)] hover:border-[var(--accent-gold)]/40 transition-all"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
            GitHub
          </a>
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--accent-jade)] hover:border-[var(--accent-jade)]/40 transition-all"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 11a9 9 0 0 1 9 9" />
              <path d="M4 4a16 16 0 0 1 16 16" />
              <circle cx="5" cy="19" r="1" />
            </svg>
            RSS 订阅
          </a>
          <a
            href="/sitemap-index.xml"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium border border-[var(--border-hairline)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-strong)] transition-all"
          >
            Sitemap
          </a>
        </div>
        <p class="text-xs text-[var(--text-muted)] pt-1">
          Powered by Astro · KaTeX · Shiki · Nginx CI/CD
        </p>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-[var(--border-hairline)] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[var(--text-muted)]">
      <p>© {year} {SITE.author}. All rights reserved.</p>
      <p class="font-mono tracking-wider">
        WUJI · 道生一，一生二，二生三，三生万物
      </p>
    </div>
  </div>
</footer>
