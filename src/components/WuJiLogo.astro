  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id="wuji-logo-grad" x1="8" y1="8" x2="56" y2="56" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#f4d48e" />
      <stop offset="55%" stop-color="#d8a24a" />
      <stop offset="100%" stop-color="#38d9c0" />
